@model List<Abstracciones.Models.Pedido>
@using System.Linq;
@{
    ViewBag.Title = "Panel de Cocina";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var mesas = ViewBag.Mesas as List<Abstracciones.Models.Mesa>;
    var detalles = ViewBag.Detalles as List<Abstracciones.Models.DetallePedido>;
    var productos = ViewBag.Productos as List<Abstracciones.Models.Producto>;
}

<div class="hero-card">
    <h2>Panel principal de cocina</h2>
    <p>
        Visualiza la cola de preparación en tiempo real, cambia el estado de los pedidos a En Preparación y márcalos como Listos para que el mesero los entregue.
    </p>
</div>

<div class="grid-4">
    <div class="metric-card"><h3>Pedidos nuevos</h3><div class="value">@(ViewBag.PedidosNuevos ?? 0)</div></div>
    <div class="metric-card alt-blue"><h3>En preparación</h3><div class="value">@(ViewBag.EnPreparacion ?? 0)</div></div>
    <div class="metric-card alt-orange"><h3>Listos por entregar</h3><div class="value">@(ViewBag.PorEntregar ?? 0)</div></div>
    <div class="metric-card alt-teal"><h3>Completados</h3><div class="value">@(ViewBag.Completados ?? 0)</div></div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success" style="margin-top:20px;">
        @TempData["Mensaje"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" style="margin-top:20px;">
        @TempData["Error"]
    </div>
}

<div id="cola-cocina" class="table-card" style="margin-top:25px;">
    <div class="section-title">
        <div>
            <h3>Cola de cocina en tiempo real</h3>
            <p>Pedidos activos pendientes de preparación o entrega a salón</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <p>No hay pedidos pendientes para cocina.</p>
    }
    else
    {
        foreach (var pedido in Model)
        {
            var mesa = mesas != null ? mesas.FirstOrDefault(m => m.IdMesa == pedido.IdMesa) : null;
            var detallesPedido = detalles != null ? detalles.Where(d => d.IdPedido == pedido.IdPedido).ToList() : null;

            <div class="quick-card" style="margin-bottom:20px;">
                <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
                    <div>
                        <h4>Pedido #@pedido.IdPedido — @(mesa != null ? mesa.NumeroMesa : "Sin mesa")</h4>
                        <p><strong>Estado actual:</strong> <span class="status @(pedido.EstadoPedido == "listo" ? "success" : pedido.EstadoPedido == "en_proceso" ? "info" : "warning")">@pedido.EstadoPedido</span> | <strong>Observaciones:</strong> @(string.IsNullOrEmpty(pedido.Observaciones) ? "Ninguna" : pedido.Observaciones)</p>
                    </div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        @if (pedido.EstadoPedido == "abierto")
                        {
                            using (Html.BeginForm("IniciarPreparacion", "Cocina", FormMethod.Post, new { style = "display:inline;" }))
                            {
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
                                @Html.Hidden("idPedido", pedido.IdPedido)
                                <button type="submit" class="btn btn-primary">Iniciar preparación</button>
                            }
                        }
                        @if (pedido.EstadoPedido == "abierto" || pedido.EstadoPedido == "en_proceso")
                        {
                            using (Html.BeginForm("MarcarPedidoListo", "Cocina", FormMethod.Post, new { style = "display:inline;" }))
                            {
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
                                @Html.Hidden("idPedido", pedido.IdPedido)
                                <button type="submit" class="btn btn-success">Marcar pedido como Listo</button>
                            }
                        }
                    </div>
                </div>

                <table style="margin-top:15px;">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Observación</th>
                            <th>Estado item</th>
                            <th>Acciones por plato</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (detallesPedido != null && detallesPedido.Any())
                        {
                            foreach (var item in detallesPedido)
                            {
                                var producto = productos != null ? productos.FirstOrDefault(p => p.IdProducto == item.IdProducto) : null;

                                <tr>
                                    <td>@(producto != null ? producto.NombreProducto : "Producto no encontrado")</td>
                                    <td>@item.Cantidad</td>
                                    <td>@item.ObservacionesItem</td>
                                    <td><span class="status @(item.EstadoItem == "listo" ? "success" : item.EstadoItem == "preparando" ? "info" : "warning")">@item.EstadoItem</span></td>
                                    <td style="display:flex;gap:6px;flex-wrap:wrap;">
                                        @if (item.EstadoItem == "pendiente")
                                        {
                                            using (Html.BeginForm("MarcarItemPreparando", "Cocina", FormMethod.Post, new { style = "display:inline;" }))
                                            {
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
                                                @Html.Hidden("idDetalle", item.IdDetalle)
                                                <button type="submit" class="btn btn-warning btn-sm">Marcar preparando</button>
                                            }
                                        }

                                        @if (item.EstadoItem == "pendiente" || item.EstadoItem == "preparando")
                                        {
                                            using (Html.BeginForm("MarcarItemListo", "Cocina", FormMethod.Post, new { style = "display:inline;" }))
                                            {
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
                                                @Html.Hidden("idDetalle", item.IdDetalle)
                                                <button type="submit" class="btn btn-secondary btn-sm">Marcar listo</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">Este pedido no tiene productos registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
