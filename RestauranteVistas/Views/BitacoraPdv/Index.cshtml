@model RestauranteVistas.Models.ViewModels.BitacoraPdvViewModel
@{
    ViewBag.Title = "Bitácora PDV";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-card">
    <h2>Bitácora del punto de venta</h2>
    <p>Registro de auditoría (solo lectura) de las operaciones rápidas de caja: aperturas, ediciones, validaciones, cobros y cancelaciones.</p>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="banner" style="background:#ffebee;border-left-color:#c62828;"><strong>@Model.Error</strong></div>
}

<a href="@Url.Action("Index", "PuntoVenta")" class="btn btn-sm" style="margin-bottom:12px;display:inline-flex;align-items:center;gap:6px;">
    <span class="material-symbols-outlined">arrow_back</span> Volver a Punto de Venta
</a>

<div class="form-card">
    <div class="section-title"><h3>Filtros</h3></div>
    <form method="get" action="@Url.Action("Index")" class="form-grid">
        <div class="form-group">
            <label>Cajero</label>
            <select name="idUsuario">
                <option value="">Todos</option>
                @if (Model.Cajeros != null)
                {
                    foreach (var kvp in Model.Cajeros.OrderBy(k => k.Value))
                    {
                        <option value="@kvp.Key" @(Model.FiltroIdUsuario == kvp.Key ? "selected" : "")>@kvp.Value</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label>Caja</label>
            <select name="idCaja">
                <option value="">Todas</option>
                @if (Model.CajasDisponibles != null)
                {
                    foreach (var c in Model.CajasDisponibles)
                    {
                        <option value="@c.IdCaja" @(Model.FiltroIdCaja == c.IdCaja ? "selected" : "")>@c.NombreCaja</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label>Acción operativa</label>
            <select name="accion">
                <option value="">Todas</option>
                @if (Model.AccionesDisponibles != null)
                {
                    foreach (var a in Model.AccionesDisponibles)
                    {
                        <option value="@a" @(Model.FiltroAccion == a ? "selected" : "")>@a</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label>Fecha inicio</label>
            <input type="date" name="fechaInicio" value="@Model.FiltroFechaInicio" />
        </div>
        <div class="form-group">
            <label>Fecha fin</label>
            <input type="date" name="fechaFin" value="@Model.FiltroFechaFin" />
        </div>
        <div class="form-actions" style="grid-column:1/-1;">
            <button type="submit" class="btn btn-secondary"><span class="material-symbols-outlined">search</span> Filtrar</button>
            <a href="@Url.Action("Index")" class="btn btn-sm"><span class="material-symbols-outlined">clear</span> Limpiar</a>
        </div>
    </form>
</div>

@if (Model.Registros != null && Model.Registros.Any())
{
    <div class="table-card">
        <div class="section-title">
            <h3>Registros</h3>
            <p>@Model.Registros.Count resultados</p>
        </div>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Cajero</th>
                    <th>Caja</th>
                    <th>Acción</th>
                    <th>Venta</th>
                    <th>Detalle</th>
                    <th>Fecha/Hora</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Registros)
                {
                    <tr>
                        <td>@r.IdRegistro</td>
                        <td>@r.NombreCajero</td>
                        <td>@r.NombreCaja</td>
                        <td>@r.AccionOperativa</td>
                        <td>@(r.IdVenta.HasValue ? "#" + r.IdVenta.Value : "-")</td>
                        <td style="max-width:300px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@r.Detalle">@r.Detalle</td>
                        <td>@r.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="form-card" style="text-align:center;padding:32px;">
        <p>No se encontraron registros en la bitácora del punto de venta.</p>
    </div>
}