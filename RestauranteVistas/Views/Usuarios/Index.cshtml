@model RestauranteVistas.Models.ViewModels.UsuariosViewModel

@{
    ViewBag.Title = "Gestion de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-card">
    <h2>Administracion de usuarios del sistema</h2>
    <p>Gestion de accesos y roles del personal.</p>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="section-card" style="border-left:4px solid #2e7d32;padding:12px 18px;margin-bottom:16px;background:#e8f5e9;">
        <h3 style="color:#2e7d32;margin:0;">@Model.Mensaje</h3>
    </div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="section-card" style="border-left:4px solid #c62828;padding:12px 18px;margin-bottom:16px;background:#ffebee;">
        <h3 style="color:#c62828;margin:0;">@Model.Error</h3>
    </div>
}

<div class="grid-3">
    <div class="metric-card"><h3>Usuarios activos</h3><div class="value">@Model.UsuariosActivos</div></div>
    <div class="metric-card alt-blue"><h3>Administradores</h3><div class="value">@Model.Administradores</div></div>
    <div class="metric-card alt-orange"><h3>Roles definidos</h3><div class="value">@Model.RolesDefinidos</div></div>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Usuarios registrados</h3>
            <p>Control de accesos</p>
        </div>
        <div>
            <button class="btn btn-primary" onclick="abrirModal('modalCrearUsuario')">
                <span class="material-symbols-outlined">person_add</span> Nuevo usuario
            </button>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Usuario</th>
                <th>Rol</th>
                <th>Correo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Usuarios != null && Model.Usuarios.Any())
            {
                foreach (var u in Model.Usuarios)
                {
                    <tr>
                        <td>@u.IdUsuario</td>
                        <td>@(Model.NombresEmpleados.ContainsKey(u.IdUsuario) ? Model.NombresEmpleados[u.IdUsuario] : u.NombreUsuario)</td>
                        <td>@(u.Rol != null ? u.Rol.NombreRol : "")</td>
                        <td>@u.Correo</td>
                        <td>
                            @if (u.Bloqueado)
                            {
                                <span class="status danger">Bloqueado</span>
                            }
                            else
                            {
                                <span class="status success">Activo</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("Editar", "Usuarios", new { id = u.IdUsuario })" class="btn btn-sm btn-primary" title="Editar">
                                <span class="material-symbols-outlined" style="font-size:16px;">edit</span>
                            </a>
                            <a href="@Url.Action("AsignarRol", "Usuarios", new { id = u.IdUsuario })" class="btn btn-sm btn-info" title="Asignar rol">
                                <span class="material-symbols-outlined" style="font-size:16px;">admin_panel_settings</span>
                            </a>
                            <button type="button" class="btn btn-sm btn-info" title="Ver informacion del empleado"
                                        onclick="verEmpleado(@u.IdUsuario)">
                                <span class="material-symbols-outlined" style="font-size:16px;">visibility</span>
                            </button>
                            @using (Html.BeginForm("ResetearPassword", "Usuarios", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                <input type="hidden" name="id" value="@u.IdUsuario" />
                                <button type="submit" class="btn btn-sm btn-info" title="Resetear contrasena"
                                        onclick="return confirm('¿Resetear contrasena de @(Model.NombresEmpleados.ContainsKey(u.IdUsuario) ? Model.NombresEmpleados[u.IdUsuario] : u.NombreUsuario)? El usuario debera crear una nueva al iniciar sesion.');">
                                    <span class="material-symbols-outlined" style="font-size:16px;">lock_reset</span>
                                </button>
                            }
                            @using (Html.BeginForm("BloquearUsuario", "Usuarios", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                <input type="hidden" name="id" value="@u.IdUsuario" />
                                <button type="submit" class="btn btn-sm @(u.Bloqueado ? "btn-success" : "btn-warning")" title="@(u.Bloqueado ? "Desbloquear" : "Bloquear")">
                                    <span class="material-symbols-outlined" style="font-size:16px;">@(u.Bloqueado ? "lock_open" : "lock")</span>
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6">No hay usuarios registrados.</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal para crear usuario (GUS 001) -->
<div id="modalCrearUsuario" class="custom-modal">
    <div class="custom-modal-content" style="max-width:500px;">
        <div class="modal-header">
            <h3>Agregar nuevo usuario</h3>
            <button class="icon-btn" onclick="cerrarModal('modalCrearUsuario')">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        @using (Html.BeginForm("CrearUsuario", "Usuarios", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Nombre de usuario *</label>
                    <input type="text" name="NuevoNombreUsuario" required placeholder="Ej: jperez" />
                </div>
                <div class="form-group">
                    <label>Correo electronico *</label>
                    <input type="email" name="NuevoCorreo" required placeholder="Ej: correo@dominio.com" />
                </div>
                <div class="form-group">
                    <label>Contrasena *</label>
                    <input type="password" name="NuevoPassword" required minlength="12"
                           placeholder="Min. 12 caracteres, mayuscula, numero y especial" />
                    <small style="color:#666;">Debe tener: minimo 12 caracteres, 1 mayuscula, 1 numero, 1 caracter especial</small>
                </div>
                <div class="form-group">
                    <label>Rol *</label>
                    <select name="NuevoIdRol" required>
                        <option value="">Seleccione...</option>
                        @if (Model.Roles != null)
                        {
                            foreach (var r in Model.Roles)
                            {
                                <option value="@r.IdRol">@r.NombreRol</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="cerrarModal('modalCrearUsuario')">Cancelar</button>
                <button type="submit" class="btn btn-primary">Agregar usuario</button>
            </div>
        }
    </div>
</div>

@if (Model.Usuarios != null && Model.Usuarios.Any(u => !u.Estado))
{
    <div class="table-card" style="margin-top:16px;">
        <div class="section-title">
            <h3>Usuarios inactivos / Depuracion</h3>
        </div>
        @using (Html.BeginForm("DepurarUsuarios", "Usuarios", FormMethod.Post))
        {
            <table>
                <thead>
                    <tr>
                        <th><input type="checkbox" id="selectAllDepurar" /></th>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Rol</th>
                        <th>Correo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Usuarios.Where(u => !u.Estado))
                    {
                        <tr>
                            <td><input type="checkbox" name="idsDepurar" value="@u.IdUsuario" /></td>
                            <td>@u.IdUsuario</td>
                            <td>@(Model.NombresEmpleados.ContainsKey(u.IdUsuario) ? Model.NombresEmpleados[u.IdUsuario] : u.NombreUsuario)</td>
                            <td>@(u.Rol?.NombreRol ?? "")</td>
                            <td>@u.Correo</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="modal-actions" style="margin-top:12px;">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Esta seguro de eliminar permanentemente los usuarios seleccionados?')">
                    <span class="material-symbols-outlined">delete_forever</span> Depurar seleccionados
                </button>
            </div>
        }
    </div>
}

<div id="modalVerEmpleado" class="custom-modal">
    <div class="custom-modal-content" style="max-width:500px;">
        <div class="modal-header">
            <h3>Información del empleado</h3>
            <button class="icon-btn" onclick="cerrarModal('modalVerEmpleado')">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div id="empleadoDetalle" style="padding:16px 0;">
            <p>Cargando...</p>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="cerrarModal('modalVerEmpleado')">Cerrar</button>
        </div>
    </div>
</div>

<script>
    function verEmpleado(idUsuario) {
        var detalle = document.getElementById('empleadoDetalle');
        detalle.innerHTML = '<p>Cargando...</p>';
        abrirModal('modalVerEmpleado');

        fetch('@Url.Action("ObtenerEmpleado", "Usuarios")?idUsuario=' + idUsuario)
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.error) {
                    detalle.innerHTML = '<p style="color:#c62828;">' + d.error + '</p>';
                    return;
                }
                detalle.innerHTML =
                    '<div class="form-grid">' +
                        '<div class="form-group" style="grid-column:1/-1;"><hr style="margin:0 0 12px 0;"></div>' +
                        '<div class="form-group"><strong>Nombre completo</strong><p style="margin:4px 0;">' + d.nombre + ' ' + d.apellidos + '</p></div>' +
                        '<div class="form-group"><strong>Cédula</strong><p style="margin:4px 0;">' + d.cedula + '</p></div>' +
                        '<div class="form-group"><strong>Usuario</strong><p style="margin:4px 0;">' + d.nombreUsuario + '</p></div>' +
                        '<div class="form-group"><strong>Rol</strong><p style="margin:4px 0;">' + d.rol + '</p></div>' +
                        '<div class="form-group"><strong>Teléfono</strong><p style="margin:4px 0;">' + (d.telefono || '—') + '</p></div>' +
                        '<div class="form-group"><strong>Correo</strong><p style="margin:4px 0;">' + d.correo + '</p></div>' +
                        '<div class="form-group" style="grid-column:1/-1;"><strong>Dirección</strong><p style="margin:4px 0;">' + (d.direccion || '—') + '</p></div>' +
                        '<div class="form-group"><strong>Salario por hora</strong><p style="margin:4px 0;">¢' + d.salarioHora + '</p></div>' +
                        '<div class="form-group"><strong>Fecha de ingreso</strong><p style="margin:4px 0;">' + d.fechaIngreso + '</p></div>' +
                        '<div class="form-group"><strong>Última modificación</strong><p style="margin:4px 0;">' + d.fechaModificacion + '</p></div>' +
                        '<div class="form-group"><strong>Vacaciones disponibles</strong><p style="margin:4px 0;">' + d.vacacionesDisponibles + ' días</p></div>' +
                        '<div class="form-group"><strong>Estado</strong><p style="margin:4px 0;">' + d.estado + '</p></div>' +
                        '<div class="form-group" style="grid-column:1/-1;"><hr style="margin:0 0 12px 0;"></div>' +
                    '</div>';
            })
            .catch(function() {
                detalle.innerHTML = '<p style="color:#c62828;">Error al cargar la información.</p>';
            });
    }
</script>
