@model RestauranteVistas.Models.ViewModels.UsuariosViewModel

@{
    ViewBag.Title = "Bitacora de Acceso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-card">
    <div>
        <span class="mini-badge">GUS-008</span>
        <h2>Bitacora de Acceso</h2>
        <p>Auditoria de inicios y cierres de sesion, bloqueos y accesos al sistema.</p>
    </div>
</div>

<div class="form-card">
    <div class="section-title">
        <div>
            <h3>Filtros de consulta</h3>
        </div>
    </div>
    @using (Html.BeginForm("BitacoraAcceso", "Usuarios", FormMethod.Get))
    {
        <div class="form-grid" style="grid-template-columns: 1fr 1fr 1fr 1fr auto;">
            <div class="form-group">
                <label>Usuario</label>
                <input type="text" name="nombreUsuario" value="@Model.FiltroNombreUsuario" placeholder="Buscar por nombre de usuario..." />
            </div>
            <div class="form-group">
                <label>Fecha inicio</label>
                <input type="date" name="fechaInicio" value="@Model.FiltroFechaInicio" />
            </div>
            <div class="form-group">
                <label>Fecha fin</label>
                <input type="date" name="fechaFin" value="@Model.FiltroFechaFin" />
            </div>
            <div class="form-group">
                <label>Accion</label>
                <select name="accion">
                    <option value="">Todas</option>
                    @if (Model.AccionesBitacoraAcceso != null)
                    {
                        foreach (var a in Model.AccionesBitacoraAcceso)
                        {
                            <option value="@a" @(Model.FiltroAccion == a ? "selected" : "")>@a</option>
                        }
                    }
                </select>
            </div>
            <div class="form-actions" style="align-self:flex-end;">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">search</span> Consultar
                </button>
            </div>
        </div>
    }
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Registros de acceso</h3>
            <p>Resultados: @(Model.BitacoraAcceso?.Count ?? 0) registros.</p>
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Usuario</th>
                <th>ID Usuario</th>
                <th>Accion</th>
                <th>Detalle</th>
                <th>IP Origen</th>
                <th>Dispositivo</th>
                <th>Fecha/Hora</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BitacoraAcceso != null && Model.BitacoraAcceso.Any())
            {
                foreach (var b in Model.BitacoraAcceso)
                {
                    <tr>
                        <td>@b.IdRegistro</td>
                        <td>@(b.Usuario != null ? b.Usuario.NombreUsuario : "")</td>
                        <td>@b.IdUsuario</td>
                        <td><span class="status info">@b.Accion</span></td>
                        <td>@b.Detalle</td>
                        <td>@b.IpOrigen</td>
                        <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@b.Dispositivo">@b.Dispositivo</td>
                        <td>@b.FechaHora.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="8">No se encontraron registros con los filtros especificados.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="form-actions" style="gap:12px;">
    <a href="@Url.Action("ExportarBitacoraAccesoExcel", "Usuarios", new { nombreUsuario = Model.FiltroNombreUsuario, fechaInicio = Model.FiltroFechaInicio, fechaFin = Model.FiltroFechaFin, accion = Model.FiltroAccion })" class="btn btn-success">
        <span class="material-symbols-outlined">download</span> Exportar a Excel (CSV)
    </a>
    <a href="@Url.Action("Index", "Usuarios")" class="btn btn-soft">
        <span class="material-symbols-outlined">arrow_back</span> Volver a Usuarios
    </a>
</div>

<style>
    .hero-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        padding: 24px;
        background: var(--surface);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        margin-bottom: 24px;
    }
</style>