@model RestauranteVistas.Models.ViewModels.EmpleadosViewModel

@{
    ViewBag.Title = "Control de Asistencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-card" style="justify-content:space-between;align-items:center;display:flex;">
    <div>
        <span class="mini-badge">GES-003</span>
        <h2>Control de Asistencia</h2>
    </div>
    <a href="@Url.Action("Index", "Empleados")" class="btn btn-soft">
        <span class="material-symbols-outlined">arrow_back</span> Volver
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="section-card" style="border-left:4px solid #2e7d32;padding:12px 18px;margin-bottom:16px;background:#e8f5e9;">
        <h3 style="color:#2e7d32;margin:0;">@Model.Mensaje</h3>
    </div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="section-card" style="border-left:4px solid #c62828;padding:12px 18px;margin-bottom:16px;background:#ffebee;">
        <h3 style="color:#c62828;margin:0;">@Model.Error</h3>
    </div>
}

<div class="grid-2">
    <div class="form-card" style="border-top:6px solid #2e7d32;">
        <div class="section-title">
            <h3>Registrar entrada</h3>
        </div>
        @using (Html.BeginForm("RegistrarEntrada", "Empleados", FormMethod.Post))
        {
            <div class="form-grid" style="grid-template-columns:1fr auto;">
                <div class="form-group">
                    <label>ID Empleado *</label>
                    <input type="number" name="idEmpleado" required min="1" placeholder="Ej. 1" />
                </div>
                <div class="form-actions" style="align-self:flex-end;">
                    <button type="submit" class="btn btn-success">
                        <span class="material-symbols-outlined">login</span> Entrada
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="form-card" style="border-top:6px solid #c62828;">
        <div class="section-title">
            <h3>Registrar salida</h3>
        </div>
        @using (Html.BeginForm("RegistrarSalidaPorEmpleado", "Empleados", FormMethod.Post))
        {
            <div class="form-grid" style="grid-template-columns:1fr auto;">
                <div class="form-group">
                    <label>ID Empleado *</label>
                    <input type="number" name="idEmpleado" required min="1" placeholder="Su ID" />
                </div>
                <div class="form-actions" style="align-self:flex-end;">
                    <button type="submit" class="btn btn-danger">
                        <span class="material-symbols-outlined">logout</span> Salida
                    </button>
                </div>
            </div>
        }
        <hr style="margin:16px 0;border-color:var(--border);" />
        @using (Html.BeginForm("RegistrarSalida", "Empleados", FormMethod.Post))
        {
            <div class="form-grid" style="grid-template-columns:1fr auto;">
                <div class="form-group">
                    <label>ID Asistencia</label>
                    <input type="number" name="idAsistencia" placeholder="Ej. 1" />
                </div>
                <div class="form-actions" style="align-self:flex-end;">
                    <button type="submit" class="btn btn-soft">
                        <span class="material-symbols-outlined">logout</span> Salida por ID
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.AsistenciasPendientes != null && Model.AsistenciasPendientes.Any())
{
    <div class="section-card" style="border-left:4px solid #ff9800;padding:12px 18px;margin:16px 0;background:#fff3e0;">
        <h3 style="color:#e65100;margin:0;">
            <span class="material-symbols-outlined" style="vertical-align:middle;">warning</span>
            Asistencias pendientes de salida: @Model.AsistenciasPendientes.Count
        </h3>
    </div>
}

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Asistencias del día (@ViewBag.FechaAsistencia)</h3>
        </div>
        <form method="get" action="@Url.Action("Asistencia", "Empleados")" style="display:flex;align-items:center;gap:8px;">
            <label for="fechaAsistencia" style="white-space:nowrap;">Filtrar por fecha:</label>
            <input type="date" name="fecha" id="fechaAsistencia" value="@ViewBag.FechaAsistencia" class="form-control" style="width:auto;" />
            <button type="submit" class="btn btn-sm btn-soft">Ver</button>
        </form>
    </div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Empleado</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Asistencias != null && Model.Asistencias.Any())
            {
                foreach (var a in Model.Asistencias)
                {
                    <tr>
                        <td>@a.IdAsistencia</td>
                        <td>@(a.Empleado != null ? a.Empleado.Nombre + " " + a.Empleado.Apellidos : "") (#@a.IdEmpleado)</td>
                        <td>@a.FechaHoraEntrada.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@(a.FechaHoraSalida != null ? a.FechaHoraSalida.Value.ToString("yyyy-MM-dd HH:mm:ss") : "—")</td>
                        <td>
                            @if (a.FechaHoraSalida == null)
                            {
                                <span class="status warning"><span class="material-symbols-outlined" style="font-size:14px;vertical-align:middle;">schedule</span> Pendiente</span>
                            }
                            else
                            {
                                <span class="status success">Completado</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5">Sin registros de asistencia para hoy.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Asistencias pendientes general</h3>
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Empleado</th>
                <th>Entrada</th>
                <th>Acci&oacute;n</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.AsistenciasPendientes != null && Model.AsistenciasPendientes.Any())
            {
                foreach (var a in Model.AsistenciasPendientes)
                {
                    <tr>
                        <td>@a.IdAsistencia</td>
                        <td>@(a.Empleado != null ? a.Empleado.Nombre + " " + a.Empleado.Apellidos : "") (#@a.IdEmpleado)</td>
                        <td>@a.FechaHoraEntrada.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            @using (Html.BeginForm("RegistrarSalida", "Empleados", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                <input type="hidden" name="idAsistencia" value="@a.IdAsistencia" />
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <span class="material-symbols-outlined" style="font-size:14px;">logout</span> Registrar salida
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4">No hay asistencias pendientes.</td></tr>
            }
        </tbody>
    </table>
</div>
