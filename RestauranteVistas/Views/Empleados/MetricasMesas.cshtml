@model RestauranteVistas.Models.ViewModels.EmpleadosViewModel

@{
    ViewBag.Title = "Productividad - Mesas Atendidas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var semanaInicio = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek);
    var semanaFin = semanaInicio.AddDays(6);
}

<div class="hero-card" style="justify-content:space-between;align-items:center;display:flex;">
    <div>
        <span class="mini-badge">GES-004</span>
        <h2>Productividad: Mesas Atendidas</h2>
        <p>M&eacute;tricas de desempe&ntilde;o del personal de meseros.</p>
    </div>
    <a href="@Url.Action("Index", "Empleados")" class="btn btn-soft">
        <span class="material-symbols-outlined">arrow_back</span> Volver
    </a>
</div>

<div class="grid-2">
    <div class="table-card">
        <div class="section-title">
            <div>
                <h3>Total mesas del d&iacute;a (@DateTime.Today.ToString("dd/MM/yyyy"))</h3>
                <p>Agrupado por empleado.</p>
            </div>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Empleado</th>
                    <th>Mesas atendidas</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MetricasMesas != null && Model.MetricasMesas.Any())
                {
                    var total = Model.MetricasMesas.Sum(m => m.TotalMesas);
                    foreach (var m in Model.MetricasMesas)
                    {
                        <tr>
                            <td>@m.NombreEmpleado (#@m.IdEmpleado)</td>
                            <td><strong>@m.TotalMesas</strong></td>
                        </tr>
                    }
                    <tr style="font-weight:bold;background:#e8f5e9;">
                        <td>Total</td>
                        <td>@total</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="2">Sin registros para hoy.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-card">
        <div class="section-title">
            <div>
                <h3>Total mesas de la semana</h3>
                <p>@semanaInicio.ToString("dd/MM/yyyy") - @semanaFin.ToString("dd/MM/yyyy")</p>
            </div>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Empleado</th>
                    <th>Fecha</th>
                    <th>Mesas</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.MetricasMesasSemana != null && Model.MetricasMesasSemana.Any())
                {
                    var total = Model.MetricasMesasSemana.Sum(m => m.TotalMesas);
                    foreach (var m in Model.MetricasMesasSemana)
                    {
                        <tr>
                            <td>@m.NombreEmpleado (#@m.IdEmpleado)</td>
                            <td>@m.FechaHora.ToString("dd/MM/yyyy")</td>
                            <td><strong>@m.TotalMesas</strong></td>
                        </tr>
                    }
                    <tr style="font-weight:bold;background:#e8f5e9;">
                        <td colspan="2">Total</td>
                        <td>@total</td>
                    </tr>
                }
                else
                {
                    <tr><td colspan="3">Sin registros para esta semana.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
