@model List<Abstracciones.Models.HoraExtra>

@{
    ViewBag.Title = "Resumen de Horas Extra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empleados = ViewBag.Empleados as List<Abstracciones.Models.Empleado>;
}

<div class="hero-card" style="justify-content:space-between;align-items:center;display:flex;">
    <div>
        <span class="mini-badge">GES-006</span>
        <h2>Resumen de Horas Extra</h2>
    </div>
    <a href="@Url.Action("Index", "Empleados")" class="btn btn-soft">
        <span class="material-symbols-outlined">arrow_back</span> Volver
    </a>
</div>

@if (ViewBag.Mensaje != null)
{
    <div class="section-card" style="border-left:4px solid #2e7d32;padding:12px 18px;margin-bottom:16px;background:#e8f5e9;">
        <h3 style="color:#2e7d32;margin:0;">@ViewBag.Mensaje</h3>
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="section-card" style="border-left:4px solid #c62828;padding:12px 18px;margin-bottom:16px;background:#ffebee;">
        <h3 style="color:#c62828;margin:0;">@ViewBag.Error</h3>
    </div>
}

<div class="section-card" style="margin-bottom:20px;">
    <div class="section-title">
        <h3>Filtros</h3>
    </div>
    @using (Html.BeginForm("ResumenHorasExtra", "Empleados", FormMethod.Get))
    {
        <div class="form-grid" style="grid-template-columns:1fr 1fr 1fr auto;gap:12px;">
            <div class="form-group">
                <label>Empleado</label>
                <select name="idEmpleado">
                    <option value="">Todos</option>
                    @if (empleados != null)
                    {
                        foreach (var emp in empleados)
                        {
                            <option value="@emp.IdEmpleado" @(ViewBag.FiltroIdEmpleado == emp.IdEmpleado ? "selected" : "")>@emp.Nombre @emp.Apellidos</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Fecha inicio</label>
                <input type="date" name="fechaInicio" value="@ViewBag.FiltroFechaInicio" />
            </div>
            <div class="form-group">
                <label>Fecha fin</label>
                <input type="date" name="fechaFin" value="@ViewBag.FiltroFechaFin" />
            </div>
            <div class="form-actions" style="align-self:flex-end;">
                <button type="submit" class="btn btn-soft">
                    <span class="material-symbols-outlined">search</span> Consultar
                </button>
            </div>
        </div>
    }
</div>

<div class="grid-3" style="margin-bottom:20px;">
    <div class="metric-card">
        <h3>Total registros</h3>
        <div class="value">@ViewBag.TotalRegistros</div>
    </div>
    <div class="metric-card alt-blue">
        <h3>Total horas</h3>
        <div class="value">@ViewBag.TotalHoras.ToString("N1")</div>
    </div>
    <div class="metric-card alt-orange">
        <h3>Total monto</h3>
        <div class="value">@ViewBag.TotalMonto.ToString("N2")</div>
    </div>
</div>

<div class="table-card">
    <div class="section-title">
        <h3>Detalle de horas extra</h3>
    </div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Empleado</th>
                <th>Fecha asistencia</th>
                <th>ID Asistencia</th>
                <th>Horas</th>
                <th>Factor</th>
                <th>Monto</th>
                <th>Fecha registro</th>
                <th>Ajustar</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var h in Model)
                {
                    <tr>
                        <td>@h.IdHoraExtra</td>
                        <td>@(h.Asistencia?.Empleado != null ? h.Asistencia.Empleado.Nombre + " " + h.Asistencia.Empleado.Apellidos : "")</td>
                        <td>@(h.Asistencia?.FechaHoraEntrada.ToString("dd/MM/yyyy") ?? "")</td>
                        <td>@h.IdAsistencia</td>
                        <td>@h.CantidadHoras.ToString("N1")</td>
                        <td>@h.FactorPago.ToString("N2")</td>
                        <td style="font-weight:700;">@(h.MontoCalculado?.ToString("N2") ?? "—")</td>
                        <td>@h.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @using (Html.BeginForm("AjustarHorasExtra", "Empleados", FormMethod.Post, new { style = "display:flex;gap:4px;align-items:center;flex-wrap:wrap;" }))
                            {
                                <input type="hidden" name="idHoraExtra" value="@h.IdHoraExtra" />
                                <input type="number" name="cantidadHoras" step="0.5" min="0.5" value="@h.CantidadHoras" required style="width:60px;padding:3px 6px;font-size:12px;border:1px solid var(--border);border-radius:4px;" />
                                <input type="text" name="motivoAjuste" placeholder="Motivo" required style="width:100px;padding:3px 6px;font-size:12px;border:1px solid var(--border);border-radius:4px;" />
                                <button type="submit" class="btn btn-sm btn-warning" style="padding:3px 8px;font-size:11px;">
                                    <span class="material-symbols-outlined" style="font-size:12px;">edit</span> Ajustar
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="9">Sin registros de horas extra.</td></tr>
            }
        </tbody>
    </table>
</div>
