@model RestauranteVistas.Controllers.EmpleadosViewModel

@{
    ViewBag.Title = "Gestión de Empleados";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empleadosActivos = Model.Empleados.Where(e => e.Estado == "Activo").ToList();
}

<div class="hero-card empleados-hero">
    <div>
        <span class="mini-badge">Equipo operativo</span>
        <h2>Gestión de Empleados</h2>
        <p>Control diario.</p>
    </div>
    <div class="hero-summary">
        <strong>@Model.UltimoMovimiento</strong>
        <span>Último movimiento registrado</span>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="section-card">
        <h3>@TempData["Mensaje"]</h3>
    </div>
}

<div class="grid-3">
    <div class="metric-card">
        <h3>Empleados activos</h3>
        <div class="value">@Model.EmpleadosActivos</div>
    </div>
    <div class="metric-card alt-blue">
        <h3>Turnos programados</h3>
        <div class="value">@Model.TurnosProgramados</div>
    </div>
    <div class="metric-card alt-orange">
        <h3>Mesas gestionadas</h3>
        <div class="value">@Model.MesasGestionadas</div>
    </div>
</div>

<div class="grid-2">

    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>GES-001 Registrar empleados</h3>
                <p>Nuevo empleado.</p>
            </div>
        </div>

        @using (Html.BeginForm("RegistrarEmpleado", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Nombre completo</label>
                    <input type="text" name="nombre" required />
                </div>

                <div class="form-group">
                    <label>Cédula</label>
                    <input type="text" name="cedula" required />
                </div>

                <div class="form-group">
                    <label>Rol</label>
                    <select name="rol">
                        <option>Administrador</option>
                        <option>Mesero</option>
                        <option>Cocinero</option>
                        <option>Cajero</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Teléfono</label>
                    <input type="text" name="telefono" required />
                </div>

                <div class="form-group">
                    <label>Correo</label>
                    <input type="email" name="correo" required />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">save</span> Registrar empleado
                </button>
            </div>
        }
    </div>

    <div class="form-card feature-form-card">
        <div class="section-title">
            <div>
                <span class="mini-badge">GES-003</span>
                <h3>Programar turno</h3>
                <p>Nuevo turno.</p>
            </div>
        </div>

        @using (Html.BeginForm("CrearTurno", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Empleado</label>
                    <select name="empleado">
                        @foreach (var empleado in empleadosActivos)
                        {
                            <option>@empleado.Nombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Día</label>
                    <select name="dia" required>
                        <option>Lunes</option>
                        <option>Martes</option>
                        <option>Miércoles</option>
                        <option>Jueves</option>
                        <option>Viernes</option>
                        <option>Sábado</option>
                        <option>Domingo</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Hora inicio</label>
                    <input type="time" name="horaInicio" required />
                </div>

                <div class="form-group">
                    <label>Hora fin</label>
                    <input type="time" name="horaFin" required />
                </div>

                <div class="form-group">
                    <label>Área</label>
                    <select name="area" required>
                        <option>Salón principal</option>
                        <option>Terraza</option>
                        <option>Cocina caliente</option>
                        <option>Cocina fría</option>
                        <option>Caja</option>
                    </select>
                </div>

                <div class="form-group form-group-wide">
                    <label>Observaciones</label>
                    <textarea name="observaciones" placeholder="Notas breves"></textarea>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">event_available</span> Guardar turno
                </button>
            </div>
        }
    </div>

</div>

<div class="grid-2">

    <div class="form-card feature-form-card">
        <div class="section-title">
            <div>
                <span class="mini-badge">GES-004</span>
                <h3>Registrar atención de mesa</h3>
                <p>Nueva atención.</p>
            </div>
        </div>

        @using (Html.BeginForm("RegistrarMesa", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Empleado</label>
                    <select name="empleado">
                        @foreach (var empleado in empleadosActivos)
                        {
                            <option>@empleado.Nombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Número de mesa</label>
                    <input type="number" name="numeroMesa" min="1" required />
                </div>

                <div class="form-group">
                    <label>Fecha</label>
                    <input type="date" name="fecha" required />
                </div>

                <div class="form-group">
                    <label>Franja</label>
                    <select name="franja" required>
                        <option>Desayuno</option>
                        <option>Almuerzo</option>
                        <option>Cena</option>
                        <option>Evento especial</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Estado</label>
                    <select name="estadoAtencion" required>
                        <option>Atendida</option>
                        <option>Reservada</option>
                        <option>En seguimiento</option>
                        <option>Cerrada</option>
                    </select>
                </div>

                <div class="form-group form-group-wide">
                    <label>Observaciones</label>
                    <textarea name="observaciones" placeholder="Notas breves"></textarea>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">room_service</span> Registrar atención
                </button>
            </div>
        }
    </div>

    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>GES-005 Gestionar vacaciones</h3>
                <p>Vacaciones.</p>
            </div>
        </div>

        @using (Html.BeginForm("GestionarVacaciones", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Empleado</label>
                    <select name="empleado">
                        @foreach (var empleado in Model.Empleados.Where(e => e.Estado == "Activo"))
                        {
                            <option>@empleado.Nombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Fecha inicio</label>
                    <input type="date" name="fechaInicio" required />
                </div>

                <div class="form-group">
                    <label>Fecha fin</label>
                    <input type="date" name="fechaFin" required />
                </div>

                <div class="form-group">
                    <label>Días solicitados</label>
                    <input type="number" name="dias" required />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">beach_access</span> Registrar vacaciones
                </button>
            </div>
        }
    </div>

</div>

<div class="grid-2">

    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>GES-006 Registrar horas extra</h3>
                <p>Horas extra.</p>
            </div>
        </div>

        @using (Html.BeginForm("RegistrarHorasExtra", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Empleado</label>
                    <select name="empleado">
                        @foreach (var empleado in Model.Empleados.Where(e => e.Estado == "Activo"))
                        {
                            <option>@empleado.Nombre</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Fecha</label>
                    <input type="date" name="fecha" required />
                </div>

                <div class="form-group">
                    <label>Cantidad de horas</label>
                    <input type="number" name="cantidadHoras" required />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">more_time</span> Registrar horas extra
                </button>
            </div>
        }
    </div>

    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>GES-002 Administrar empleados</h3>
                <p>Editar empleado.</p>
            </div>
        </div>

        @using (Html.BeginForm("AdministrarEmpleado", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>ID empleado</label>
                    <input type="number" name="id" placeholder="1001" required />
                </div>

                <div class="form-group">
                    <label>Nombre</label>
                    <input type="text" name="nombre" required />
                </div>

                <div class="form-group">
                    <label>Rol</label>
                    <select name="rol">
                        <option>Administrador</option>
                        <option>Mesero</option>
                        <option>Cocinero</option>
                        <option>Cajero</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Teléfono</label>
                    <input type="text" name="telefono" required />
                </div>

                <div class="form-group">
                    <label>Correo</label>
                    <input type="email" name="correo" required />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-warning">
                    <span class="material-symbols-outlined">edit</span> Actualizar empleado
                </button>
            </div>
        }
    </div>

</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Listado de empleados</h3>
            <p>Estado actual.</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Empleado</th>
                <th>Cédula</th>
                <th>Rol</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>Estado</th>
                <th>GES-007</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var empleado in Model.Empleados)
            {
                <tr>
                    <td>@empleado.Id</td>
                    <td>@empleado.Nombre</td>
                    <td>@empleado.Cedula</td>
                    <td>@empleado.Rol</td>
                    <td>@empleado.Telefono</td>
                    <td>@empleado.Correo</td>
                    <td>
                        @if (empleado.Estado == "Activo")
                        {
                            <span class="status success">Activo</span>
                        }
                        else
                        {
                            <span class="status danger">Inactivo</span>
                        }
                    </td>
                    <td>
                        @if (empleado.Estado == "Activo")
                        {
                            using (Html.BeginForm("EliminarEmpleado", "Empleados", FormMethod.Post))
                            {
                                <input type="hidden" name="id" value="@empleado.Id" />
                                <button type="submit" class="btn btn-danger">
                                    Desactivar
                                </button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Registros creados durante el Sprint</h3>
            <p>Registros recientes.</p>
        </div>
    </div>

    <h4>Turnos registrados</h4>
    <table>
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Día</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Área</th>
                <th>Estado</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var turno in Model.Turnos)
            {
                <tr>
                    <td>@turno.Empleado</td>
                    <td>@turno.Dia</td>
                    <td>@turno.HoraInicio</td>
                    <td>@turno.HoraFin</td>
                    <td>@turno.Area</td>
                    <td><span class="status info">@turno.Estado</span></td>
                    <td>@turno.Observaciones</td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Mesas atendidas</h4>
    <table>
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Mesa</th>
                <th>Fecha</th>
                <th>Franja</th>
                <th>Estado</th>
                <th>Observaciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var mesa in Model.MesasAtendidas)
            {
                <tr>
                    <td>@mesa.Empleado</td>
                    <td>@mesa.NumeroMesa</td>
                    <td>@mesa.Fecha</td>
                    <td>@mesa.Franja</td>
                    <td><span class="status success">@mesa.EstadoAtencion</span></td>
                    <td>@mesa.Observaciones</td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Vacaciones registradas</h4>
    <table>
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Días</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var vacacion in Model.Vacaciones)
            {
                <tr>
                    <td>@vacacion.Empleado</td>
                    <td>@vacacion.FechaInicio</td>
                    <td>@vacacion.FechaFin</td>
                    <td>@vacacion.Dias</td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Horas extra registradas</h4>
    <table>
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Fecha</th>
                <th>Horas</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var hora in Model.HorasExtra)
            {
                <tr>
                    <td>@hora.Empleado</td>
                    <td>@hora.Fecha</td>
                    <td>@hora.CantidadHoras</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="story-card">
    <h4>Historias</h4>

    <div class="accordion">
        <div class="accordion-item">
            <button class="accordion-header">GES-001 Registrar empleados <span>+</span></button>
            <div class="accordion-content">Registro de empleados.</div>
        </div>

        <div class="accordion-item">
            <button class="accordion-header">GES-002 Administrar empleados <span>+</span></button>
            <div class="accordion-content">Edición de empleados.</div>
        </div>

        <div class="accordion-item">
            <button class="accordion-header">GES-003 Programar turnos <span>+</span></button>
            <div class="accordion-content">Programación de turnos.</div>
        </div>

        <div class="accordion-item">
            <button class="accordion-header">GES-004 Registrar atención de mesas <span>+</span></button>
            <div class="accordion-content">Atención de mesas.</div>
        </div>

        <div class="accordion-item">
            <button class="accordion-header">GES-005 Gestionar vacaciones <span>+</span></button>
            <div class="accordion-content">Gestión de vacaciones.</div>
        </div>

        <div class="accordion-item">
            <button class="accordion-header">GES-006 Registrar horas extra <span>+</span></button>
            <div class="accordion-content">Registro de horas extra.</div>
        </div>

        <div class="accordion-item">
            <button class="accordion-header">GES-007 Desactivar usuarios inactivos <span>+</span></button>
            <div class="accordion-content">Desactivación de empleados.</div>
        </div>
    </div>
</div>

<style>
    .empleados-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }

    .hero-summary {
        min-width: 260px;
        padding: 18px;
        border-radius: var(--radius-md);
        background: rgba(255,255,255,0.72);
        border: 1px solid var(--border);
    }

    .hero-summary strong,
    .hero-summary span {
        display: block;
    }

    .hero-summary strong {
        color: var(--sapphire);
        font-size: 18px;
        margin-bottom: 4px;
    }

    .feature-form-card {
        border-top: 6px solid var(--emerald);
    }

    .form-group-wide {
        grid-column: 1 / -1;
    }

    .table-card h4 {
        margin: 26px 0 12px;
        color: var(--emerald);
    }

    @@media (max-width: 900px) {
        .empleados-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .hero-summary {
            min-width: 0;
            width: 100%;
        }
    }
</style>
