@model RestauranteVistas.Models.ViewModels.EmpleadosViewModel

@{
    ViewBag.Title = "Gestión de Empleados";
    var searchTerm = Model?.TerminoBusqueda ?? "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empleadosActivos = Model.Empleados != null ? Model.Empleados.Where(e => e.Estado).ToList() : new List<Abstracciones.Models.Empleado>();
}

<div class="hero-card empleados-hero">
    <div>
        <span class="mini-badge">Equipo operativo Colibrí</span>
        <h2>Gestión de Personal y Nómina</h2>
        <p>Administración integral de colaboradores, turnos y vacaciones.</p>

        <a href="@Url.Action("Bitacora", "Empleados")" class="btn btn-outline" style="margin-top: 12px; display: inline-flex; align-items: center; gap: 8px;">
            <span class="material-symbols-outlined">history</span> Auditar Movimientos (Bitácora)
        </a>
    </div>
    <div class="hero-summary">
        <strong>@Model.UltimoMovimiento</strong>
        <span>Último movimiento registrado</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert-box alert-success">
        <span class="material-symbols-outlined">check_circle</span>
        <h3>@Model.Mensaje</h3>
    </div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert-box alert-danger">
        <span class="material-symbols-outlined">error</span>
        <h3>@Model.Error</h3>
    </div>
}

<div class="grid-3" style="margin-bottom: 24px;">
    <div class="metric-card">
        <h3>Empleados activos</h3>
        <div class="value">@Model.EmpleadosActivos</div>
    </div>
    <div class="metric-card alt-blue">
        <h3>Turnos programados (Hoy)</h3>
        <div class="value">@Model.TurnosProgramados</div>
    </div>
    <div class="metric-card alt-orange">
        <h3>Vacaciones pendientes</h3>
        <div class="value">@(Model.Vacaciones?.Count ?? 0)</div>
    </div>
</div>

<div class="tabs-container">
    <div class="tabs-header">
        <button class="tab-btn active" onclick="openTab(event, 'tab-empleados')">
            <span class="material-symbols-outlined">badge</span> GES-001/002: Personal
        </button>
        <button class="tab-btn" onclick="openTab(event, 'tab-turnos')">
            <span class="material-symbols-outlined">schedule</span> GES-003: Turnos
        </button>
        <button class="tab-btn" onclick="openTab(event, 'tab-mesas')">
            <span class="material-symbols-outlined">restaurant</span> GES-004: Mesas
        </button>
        <button class="tab-btn" onclick="openTab(event, 'tab-nomina')">
            <span class="material-symbols-outlined">paid</span> GES-005/006: Nómina
        </button>
    </div>

    <div id="tab-empleados" class="tab-content" style="display: block;">
        <div class="grid-2">
            <div class="form-card">
                <div class="section-title">
                    <div>
                        <h3>Registrar Empleado</h3>
                        <p>Ingreso de nuevo personal al sistema.</p>
                    </div>
                </div>
                @using (Html.BeginForm("RegistrarEmpleado", "Empleados", FormMethod.Post))
                {
                    <div class="form-grid">
                        <div class="form-group"><label>Cédula *</label><input type="text" name="cedula" required /></div>
                        <div class="form-group"><label>Nombre *</label><input type="text" name="nombre" required /></div>
                        <div class="form-group"><label>Apellidos *</label><input type="text" name="apellidos" required /></div>
                        <div class="form-group"><label>Teléfono</label><input type="text" name="telefono" /></div>
                        <div class="form-group"><label>Correo</label><input type="email" name="correo" /></div>
                        <div class="form-group">
                            <label>Rol *</label>
                            <select name="rol" required>
                                <option value="">Seleccione...</option>
                                @if (Model.Roles != null)
                                {
                                    foreach (var r in Model.Roles)
                                    {
                                        <option value="@r.NombreRol">@r.NombreRol</option>
}
                                }
                            </select>
                        </div>
                        <div class="form-group"><label>Fecha Ingreso *</label><input type="date" name="fechaIngreso" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                        <div class="form-group"><label>Salario/Hora *</label><input type="number" step="0.01" min="0.01" name="salarioHora" required /></div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined">save</span> Registrar</button>
                    </div>
                }
            </div>

            <div style="display:flex; flex-direction:column; gap:24px;">
                <div class="form-card">
                    <div class="section-title">
                        <div>
                            <h3>Editar Empleado</h3>
                            <p>Actualizar datos contractuales.</p>
                        </div>
                    </div>
                    @using (Html.BeginForm("AdministrarEmpleado", "Empleados", FormMethod.Post))
                    {
                        <div class="form-grid">
                            <div class="form-group"><label>ID Empleado *</label><input type="number" name="id" required /></div>
                            <div class="form-group"><label>Teléfono</label><input type="text" name="telefono" /></div>
                            <div class="form-group"><label>Correo</label><input type="email" name="correo" /></div>
                            <div class="form-group"><label>Salario/Hora *</label><input type="number" step="0.01" min="0.01" name="salarioHora" required /></div>
                            <div class="form-group form-group-wide">
                                <label>Rol</label>
                                <select name="rol">
                                    <option value="">Sin cambio</option>
                                    @if (Model.Roles != null)
                                    {
                                        foreach (var r in Model.Roles)
                                        {
                                            <option value="@r.NombreRol">@r.NombreRol</option>
}
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-actions"><button type="submit" class="btn btn-warning"><span class="material-symbols-outlined">edit</span> Actualizar</button></div>
                    }
                </div>

                <div class="form-card" style="border-top: 4px solid var(--danger);">
                    <div class="section-title">
                        <div><h3>Estado Operativo</h3></div>
                    </div>
                    <div class="grid-2" style="gap:12px;">
                        @using (Html.BeginForm("InactivarEmpleado", "Empleados", FormMethod.Post, new { style = "margin:0;" }))
                        {
                            <div class="form-group"><input type="number" name="id" placeholder="ID Empleado" required style="margin-bottom:8px;" /></div>
                            <div class="form-group"><input type="text" name="motivoInactivacion" placeholder="Motivo (Despido...)" required style="margin-bottom:8px;" /></div>
                            <button type="submit" class="btn btn-danger" style="width:100%"><span class="material-symbols-outlined">person_off</span> Inactivar</button>
                        }
                        @using (Html.BeginForm("ReactivarEmpleado", "Empleados", FormMethod.Post, new { style = "margin:0;" }))
                        {
                            <div class="form-group"><input type="number" name="id" placeholder="ID Empleado" required style="margin-bottom:8px;" /></div>
                            <button type="submit" class="btn btn-success" style="width:100%; margin-top: 48px;"><span class="material-symbols-outlined">person</span> Reactivar</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="table-card" style="margin-top: 24px;">
            <div class="section-title">
                <div><h3>Directorio de Personal</h3></div>
                @using (Html.BeginForm("BuscarEmpleados", "Empleados", FormMethod.Get, new { style = "display:flex;gap:6px;" }))
                {
                    <input type="text" name="termino" value="@searchTerm" placeholder="Buscar..." class="search-input" />
                    <button type="submit" class="btn btn-soft"><span class="material-symbols-outlined">search</span></button>
                }
            </div>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr><th>ID</th><th>Nombre</th><th>Cédula</th><th>Rol</th><th>Teléfono</th><th>Salario/h</th><th>Estado</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Empleados != null && Model.Empleados.Any())
                        {
                            foreach (var emp in Model.Empleados)
                            {
                                <tr>
                                    <td><strong>@emp.IdEmpleado</strong></td>
                                    <td>@emp.Nombre @emp.Apellidos</td>
                                    <td>@emp.Cedula</td>
                                    <td>@(emp.Usuario?.Rol?.NombreRol ?? "N/A")</td>
                                    <td>@emp.Telefono</td>
                                    <td>₡@emp.SalarioHora.ToString("N2")</td>
                                    <td><span class="status @(emp.Estado ? "success" : "danger")">@(emp.Estado ? "Activo" : "Inactivo")</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="tab-turnos" class="tab-content">
        <div class="grid-2">
            <div class="form-card feature-form-card">
                <div class="section-title">
                    <div><h3>Asignar Turno de Trabajo</h3><p>Organización de jornada.</p></div>
                </div>
                @using (Html.BeginForm("CrearTurno", "Empleados", FormMethod.Post))
                {
                    <div class="form-grid">
                        <div class="form-group form-group-wide">
                            <label>Empleado *</label>
                            <select name="idEmpleado" required>
                                <option value="">Seleccione empleado activo...</option>
                                @foreach (var emp in empleadosActivos)
                                {
                                    <option value="@emp.IdEmpleado">@emp.Nombre @emp.Apellidos</option>
}
                            </select>
                        </div>
                        <div class="form-group"><label>Fecha *</label><input type="date" name="fechaTurno" required /></div>
                        <div class="form-group"></div>
                        <div class="form-group"><label>Hora inicio *</label><input type="time" name="horaInicio" required /></div>
                        <div class="form-group"><label>Hora fin *</label><input type="time" name="horaFin" required /></div>
                        <div class="form-group form-group-wide"><label>Descripción</label><textarea name="descripcion"></textarea></div>
                    </div>
                    <div class="form-actions"><button type="submit" class="btn btn-primary"><span class="material-symbols-outlined">event_available</span> Guardar turno</button></div>
                }
            </div>

            <div class="table-card">
                <div class="section-title">
                    <div><h3>Turnos de Hoy</h3><p>@DateTime.Today.ToString("dd/MM/yyyy")</p></div>
                </div>
                <div class="table-responsive">
                    <table>
                        <thead><tr><th>Empleado</th><th>Horario</th><th>Descripción</th></tr></thead>
                        <tbody>
                            @if (Model.Turnos != null && Model.Turnos.Any())
                            {
                                foreach (var t in Model.Turnos)
                                {
                                    <tr>
                                        <td>@t.Empleado?.Nombre @t.Empleado?.Apellidos</td>
                                        <td><strong>@t.HoraInicio.ToString(@"hh\:mm") - @t.HoraFin.ToString(@"hh\:mm")</strong></td>
                                        <td>@t.Descripcion</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="3">Sin turnos para hoy.</td></tr>
}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div id="tab-mesas" class="tab-content">
        <div class="grid-2">
            <div class="form-card">
                <div class="section-title">
                    <div>
                        <h3>Asignar Mesa (Servicio)</h3>
                        <p>Control de mesas en salón.</p>
                    </div>
                </div>
                @using (Html.BeginForm("AsignarMesa", "Empleados", FormMethod.Post))
                {
                    <div class="form-grid">
                        <div class="form-group">
                            <label>ID Mesa *</label>
                            <input type="number" name="idMesa" required placeholder="Ej. 5" />
                        </div>
                        <div class="form-group">
                            <label>ID Pedido *</label>
                            <input type="number" name="idPedido" required placeholder="Ej. 1042" />
                        </div>
                        <div class="form-group form-group-wide">
                            <label>Empleado (Mesero) *</label>
                            <select name="idEmpleado" required>
                                <option value="">Seleccione al mesero...</option>
                                @foreach (var emp in empleadosActivos)
                                {
                                    <option value="@emp.IdEmpleado">@emp.Nombre @emp.Apellidos</option>

                                }
                            </select>
                        </div>
                        <div class="form-group form-group-wide">
                            <label>Sector / Origen</label>
                            <select name="origenMesa">
                                <option value="Salón Principal">Salón Principal</option>
                                <option value="Terraza">Terraza</option>
                                <option value="Bar">Bar</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">room_service</span> Asignar Mesa
                        </button>
                    </div>
                }
            </div>

            <div class="metric-card alt-blue" style="display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center;">
                <span class="material-symbols-outlined" style="font-size: 48px; color: var(--sapphire); margin-bottom:16px;">query_stats</span>
                <h3>Métricas de Productividad</h3>
                <p style="margin-bottom: 16px;">Revisa el rendimiento del personal, tiempos de atención y montos generados por mesero.</p>
                <a href="@Url.Action("MetricasMesas", "Empleados")" class="btn btn-outline">
                    Abrir Reporte de Productividad
                </a>
            </div>
        </div>
    </div>

    <div id="tab-nomina" class="tab-content">
        <div class="grid-2">
            <div class="form-card">
                <div class="section-title"><div><h3>Solicitar Vacaciones</h3></div></div>
                @using (Html.BeginForm("SolicitarVacacion", "Empleados", FormMethod.Post))
                {
                    <div class="form-grid">
                        <div class="form-group form-group-wide">
                            <label>Empleado *</label>
                            <select name="idEmpleado" required>
                                <option value="">Seleccione...</option>
                                @foreach (var emp in empleadosActivos)
                                {
                                    <option value="@emp.IdEmpleado">@emp.Nombre @emp.Apellidos</option>
}
                            </select>
                        </div>
                        <div class="form-group"><label>Inicio *</label><input type="date" name="fechaInicio" required /></div>
                        <div class="form-group"><label>Fin *</label><input type="date" name="fechaFin" required /></div>
                        <div class="form-group form-group-wide">
                            <label>Días a descontar</label>
                            <output id="diasCalculados" class="calc-box">—</output>
                        </div>
                    </div>
                    <div class="form-actions"><button type="submit" class="btn btn-primary"><span class="material-symbols-outlined">beach_access</span> Solicitar</button></div>
                }
            </div>

            <div class="form-card">
                <div class="section-title"><div><h3>Registrar Horas Extra</h3></div></div>
                @using (Html.BeginForm("RegistrarHorasExtra", "Empleados", FormMethod.Post))
                {
                    <div class="form-grid">
                        <div class="form-group form-group-wide"><label>ID Asistencia *</label><input type="number" name="idAsistencia" required placeholder="Ej. 102" /></div>
                        <div class="form-group form-group-wide"><label>Cantidad de horas *</label><input type="number" step="0.5" min="0.5" name="cantidadHoras" required /></div>
                    </div>
                    <div class="form-actions"><button type="submit" class="btn btn-primary"><span class="material-symbols-outlined">more_time</span> Registrar pago extra</button></div>
                }
            </div>
        </div>

        <div class="table-card" style="margin-top: 24px;">
            <div class="section-title"><div><h3>Aprobación de Vacaciones Pendientes</h3></div></div>
            <div class="table-responsive">
                <table>
                    <thead><tr><th>Empleado</th><th>Fechas</th><th>Días</th><th>Estado</th><th>Acciones Administrativas</th></tr></thead>
                    <tbody>
                        @if (Model.Vacaciones != null && Model.Vacaciones.Any())
                        {
                            foreach (var v in Model.Vacaciones)
                            {
                                <tr>
                                    <td>@v.Empleado?.Nombre @v.Empleado?.Apellidos</td>
                                    <td>@v.FechaInicio.ToString("dd/MM/yyyy") al @v.FechaFin.ToString("dd/MM/yyyy")</td>
                                    <td><strong>@v.DiasSolicitados</strong></td>
                                    <td><span class="status warning">@v.EstadoSolicitud</span></td>
                                    <td>
                                        @using (Html.BeginForm("AprobarVacacion", "Empleados", FormMethod.Post, new { style = "display:inline;" }))
                                        {
                                            <input type="hidden" name="idVacacion" value="@v.IdVacacion" />
                                            <button type="submit" class="btn btn-sm btn-success">Aprobar</button>
                                        }
                                        @using (Html.BeginForm("RechazarVacacion", "Empleados", FormMethod.Post, new { style = "display:inline; margin-left: 8px;" }))
                                        {
                                            <input type="hidden" name="idVacacion" value="@v.IdVacacion" />
                                            <input type="text" name="motivoRechazo" placeholder="Motivo" required style="width:120px; padding:4px; font-size:12px;" />
                                            <button type="submit" class="btn btn-sm btn-danger">Rechazar</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5">Sin solicitudes pendientes de revisión.</td></tr>
}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos del Dashboard */
    .empleados-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }

    .hero-summary {
        min-width: 260px;
        padding: 18px;
        border-radius: var(--radius-md);
        background: rgba(255,255,255,0.72);
        border: 1px solid var(--border);
    }

        .hero-summary strong {
            color: var(--sapphire);
            font-size: 18px;
            display: block;
            margin-bottom: 4px;
        }

        .hero-summary span {
            display: block;
        }

    /* Alertas */
    .alert-box {
        padding: 16px;
        margin-bottom: 20px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .alert-box h3 {
            margin: 0;
            font-size: 16px;
        }

    .alert-success {
        background-color: #e8f5e9;
        border-left: 5px solid #2e7d32;
        color: #1b5e20;
    }

    .alert-danger {
        background-color: #ffebee;
        border-left: 5px solid #c62828;
        color: #b71c1c;
    }

    /* Pestañas (Tabs) */
    .tabs-header {
        display: flex;
        gap: 8px;
        border-bottom: 2px solid var(--border);
        margin-bottom: 24px;
    }

    .tab-btn {
        background: none;
        border: none;
        padding: 12px 24px;
        font-size: 16px;
        font-weight: 600;
        color: #666;
        cursor: pointer;
        border-bottom: 3px solid transparent;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
    }

        .tab-btn:hover {
            color: var(--sapphire);
            background: rgba(0,0,0,0.02);
        }

        .tab-btn.active {
            color: var(--sapphire);
            border-bottom-color: var(--emerald);
        }

    .tab-content {
        display: none;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Utilidades */
    .feature-form-card {
        border-top: 6px solid var(--emerald);
    }

    .form-group-wide {
        grid-column: 1 / -1;
    }

    .btn-sm {
        padding: 6px 12px;
        font-size: 13px;
    }

    .search-input {
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 6px;
        font-size: 14px;
        width: 250px;
    }

    .calc-box {
        display: block;
        padding: 10px;
        background: #f5f5f5;
        border-radius: 6px;
        text-align: center;
        font-size: 18px;
        font-weight: 700;
        color: var(--sapphire);
    }

    @@media (max-width: 900px) {
        .empleados-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-summary {
            width: 100%;
        }

        .tabs-header {
            overflow-x: auto;
            white-space: nowrap;
        }
    }
</style>

<script>
    // Lógica para las Pestañas (Tabs)
    function openTab(evt, tabName) {
        var i, tabcontent, tablinks;
        tabcontent = document.getElementsByClassName("tab-content");
        for (i = 0; i < tabcontent.length; i++) {
            tabcontent[i].style.display = "none";
        }
        tablinks = document.getElementsByClassName("tab-btn");
        for (i = 0; i < tablinks.length; i++) {
            tablinks[i].className = tablinks[i].className.replace(" active", "");
        }
        document.getElementById(tabName).style.display = "block";
        evt.currentTarget.className += " active";
    }

    // Lógica para calcular días de vacaciones
    document.querySelectorAll('[name="fechaInicio"],[name="fechaFin"]').forEach(function (el) {
        el.addEventListener('change', function () {
            var fi = document.querySelector('[name="fechaInicio"]').value;
            var ff = document.querySelector('[name="fechaFin"]').value;
            if (fi && ff) {
                var d1 = new Date(fi), d2 = new Date(ff);
                if (d2 >= d1) {
                    var diff = Math.round((d2 - d1) / (1000 * 60 * 60 * 24)) + 1;
                    document.getElementById('diasCalculados').textContent = diff + ' día' + (diff > 1 ? 's' : '');
                } else { document.getElementById('diasCalculados').textContent = 'Error: Fin < Inicio'; }
            } else { document.getElementById('diasCalculados').textContent = '—'; }
        });
    });
</script>