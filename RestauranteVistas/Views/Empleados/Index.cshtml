@model RestauranteVistas.Models.ViewModels.EmpleadosViewModel

@{
    ViewBag.Title = "Gestión de Empleados";
    var searchTerm = Model?.TerminoBusqueda ?? "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empleadosActivos = Model.Empleados.Where(e => e.Estado && e.IdEmpleado != 1).ToList();
}

<div class="hero-card empleados-hero">
    <div>
        <span class="mini-badge">Equipo operativo</span>
        <h2>Gestión de Empleados</h2>
    </div>
    <div class="hero-summary">
        <strong>@Model.UltimoMovimiento</strong>
        <span>Último movimiento registrado</span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="section-card" style="border-left: 4px solid #2e7d32; padding: 12px 18px; margin-bottom: 16px; background: #e8f5e9;">
        <h3 style="color: #2e7d32; margin:0;">@Model.Mensaje</h3>
    </div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="section-card" style="border-left: 4px solid #c62828; padding: 12px 18px; margin-bottom: 16px; background: #ffebee;">
        <h3 style="color: #c62828; margin:0;">@Model.Error</h3>
    </div>
}

<div class="section-card" style="margin-bottom:20px;">
    <div class="section-title">
        <div>
            <h3>Accesos de auditoría</h3>
        </div>
    </div>

    <div class="form-actions">
        <a class="btn btn-primary" href="@Url.Action("Bitacora", "Empleados")">
            <span class="material-symbols-outlined">history</span> Bitácora de Empleados
        </a>

        <a class="btn btn-secondary" href="@Url.Action("BitacoraPedidos", "Empleados")">
            <span class="material-symbols-outlined">receipt_long</span> Bitácora de Pedidos
        </a>

        <a class="btn btn-soft" href="@Url.Action("ResumenHorasExtra", "Empleados")">
            <span class="material-symbols-outlined">more_time</span> Horas Extra
        </a>
    </div>
</div>

<div class="grid-3">
    <div class="metric-card">
        <h3>Empleados activos</h3>
        <div class="value">@Model.EmpleadosActivos</div>
    </div>
    <div class="metric-card alt-blue">
        <h3>Turnos programados</h3>
        <div class="value">@Model.TurnosProgramados</div>
    </div>
    <div class="metric-card alt-orange">
        <h3>Vacaciones pendientes</h3>
        <div class="value">@(Model.Vacaciones?.Count ?? 0)</div>
    </div>
</div>

<div class="grid-2">
    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>GES-001 Registrar empleados</h3>
            </div>
        </div>
        @using (Html.BeginForm("RegistrarEmpleado", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Cédula *</label>
                    <input type="text" name="cedula" required />
                </div>
                <div class="form-group">
                    <label>Nombre *</label>
                    <input type="text" name="nombre" required />
                </div>
                <div class="form-group">
                    <label>Apellidos *</label>
                    <input type="text" name="apellidos" required />
                </div>
                <div class="form-group">
                    <label>Teléfono</label>
                    <input type="text" name="telefono" />
                </div>
                <div class="form-group">
                    <label>Correo</label>
                    <input type="email" name="correo" />
                </div>
                <div class="form-group">
                    <label>Rol *</label>
                    <select name="rol" required>
                        <option value="">Seleccione...</option>
                        @foreach (var r in Model.Roles)
                        {
                            <option value="@r.NombreRol">@r.NombreRol</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Fecha de ingreso *</label>
                    <input type="date" name="fechaIngreso" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="form-group">
                    <label>Salario por hora *</label>
                    <input type="number" step="0.01" min="0.01" name="salarioHora" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">save</span> Registrar empleado
                </button>
            </div>
        }
    </div>

    <div class="form-card feature-form-card">
        <div class="section-title">
            <div>
                <span class="mini-badge">GES-003</span>
                <h3>Programar turno</h3>
            </div>
        </div>
        @using (Html.BeginForm("CrearTurno", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Empleado *</label>
                    <select name="idEmpleado" required>
                        <option value="">Seleccione...</option>
                        @foreach (var emp in empleadosActivos)
                        {
                            <option value="@emp.IdEmpleado">@emp.Nombre @emp.Apellidos</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Fecha *</label>
                    <input type="date" name="fechaTurno" required />
                </div>
                <div class="form-group">
                    <label>Hora inicio *</label>
                    <input type="time" name="horaInicio" required />
                </div>
                <div class="form-group">
                    <label>Hora fin *</label>
                    <input type="time" name="horaFin" required />
                </div>
                <div class="form-group form-group-wide">
                    <label>Descripción</label>
                    <textarea name="descripcion" placeholder="Notas del turno"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">event_available</span> Guardar turno
                </button>
            </div>
        }
    </div>
</div>

<div class="grid-2">
    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>GES-005 Solicitar vacaciones</h3>
            </div>
        </div>
        @using (Html.BeginForm("SolicitarVacacion", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Empleado *</label>
                    <select name="idEmpleado" required>
                        <option value="">Seleccione...</option>
                        @foreach (var emp in empleadosActivos)
                        {
                            <option value="@emp.IdEmpleado">@emp.Nombre @emp.Apellidos</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Fecha inicio *</label>
                    <input type="date" name="fechaInicio" required />
                </div>
                <div class="form-group">
                    <label>Fecha fin *</label>
                    <input type="date" name="fechaFin" required />
                </div>
                <div class="form-group">
                    <label>Días calculados</label>
                    <output id="diasCalculados" style="display:block;padding:10px;background:#f5f5f5;border-radius:6px;text-align:center;font-size:18px;font-weight:700;">—</output>
                </div>
                <script>
                    document.querySelectorAll('[name="fechaInicio"],[name="fechaFin"]').forEach(function(el){
                        el.addEventListener('change',function(){
                            var fi=document.querySelector('[name="fechaInicio"]').value;
                            var ff=document.querySelector('[name="fechaFin"]').value;
                            if(fi&&ff){
                                var d1=new Date(fi),d2=new Date(ff);
                                if(d2>=d1){
                                    var diff=Math.round((d2-d1)/(1000*60*60*24))+1;
                                    document.getElementById('diasCalculados').textContent=diff+' día'+(diff>1?'s':'');
                                }else{document.getElementById('diasCalculados').textContent='—';}
                            }else{document.getElementById('diasCalculados').textContent='—';}
                        });
                    });
                </script>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">beach_access</span> Solicitar vacaciones
                </button>
            </div>
        }
    </div>

    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>GES-006 Registrar horas extra</h3>
            </div>
        </div>
        <form method="get" action="@Url.Action("Index", "Empleados")" style="display:flex;align-items:center;gap:8px;padding:0 0 12px 0;">
            <label for="fechaHE" style="white-space:nowrap;">Asistencias del:</label>
            <input type="date" name="fechaHE" id="fechaHE" value="@ViewBag.FechaHE" class="form-control" style="width:auto;" />
            <button type="submit" class="btn btn-sm btn-soft">Filtrar</button>
        </form>
        @using (Html.BeginForm("RegistrarHorasExtra", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Asistencia *</label>
                    <select name="idAsistencia" required>
                        <option value="">Seleccione...</option>
                        @if (Model.Asistencias != null)
                        {
                            foreach (var a in Model.Asistencias)
                            {
                                <option value="@a.IdAsistencia">
                                    #@a.IdAsistencia - @(a.Empleado != null ? a.Empleado.Nombre + " " + a.Empleado.Apellidos : "") (@a.FechaHoraEntrada.ToString("dd/MM HH:mm"))
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Cantidad de horas *</label>
                    <input type="number" step="0.5" min="0.5" name="cantidadHoras" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">more_time</span> Registrar horas extra
                </button>
            </div>
        }
    </div>
</div>

<div class="grid-2">
    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>GES-002 Editar empleado</h3>
            </div>
        </div>
        @using (Html.BeginForm("AdministrarEmpleado", "Empleados", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>ID empleado *</label>
                    <input type="number" name="id" required />
                </div>
                <div class="form-group">
                    <label>Teléfono</label>
                    <input type="text" name="telefono" />
                </div>
                <div class="form-group">
                    <label>Correo</label>
                    <input type="email" name="correo" />
                </div>
                <div class="form-group">
                    <label>Rol</label>
                    <select name="rol">
                        <option value="">Sin cambio</option>
                        @foreach (var r in Model.Roles)
                        {
                            <option value="@r.NombreRol">@r.NombreRol</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Salario por hora *</label>
                    <input type="number" step="0.01" min="0.01" name="salarioHora" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-warning">
                    <span class="material-symbols-outlined">edit</span> Actualizar empleado
                </button>
            </div>
        }
    </div>

    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>GES-002 Inactivar / Reactivar</h3>
            </div>
        </div>
        <div class="grid-2" style="gap:12px;">
            @using (Html.BeginForm("InactivarEmpleado", "Empleados", FormMethod.Post, new { style = "margin:0;" }))
            {
                <div class="form-grid">
                    <div class="form-group">
                        <label>ID empleado *</label>
                        <input type="number" name="id" required />
                    </div>
                    <div class="form-group">
                        <label>Motivo de inactivación *</label>
                        <input type="text" name="motivoInactivacion" required placeholder="Renuncia, despido..." />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">
                        <span class="material-symbols-outlined">person_off</span> Inactivar
                    </button>
                </div>
            }
            @using (Html.BeginForm("ReactivarEmpleado", "Empleados", FormMethod.Post, new { style = "margin:0;" }))
            {
                <div class="form-grid">
                    <div class="form-group">
                        <label>ID empleado *</label>
                        <input type="number" name="id" required />
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-success">
                        <span class="material-symbols-outlined">person</span> Reactivar
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Listado de empleados</h3>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
            @using (Html.BeginForm("BuscarEmpleados", "Empleados", FormMethod.Get, new { style = "display:flex;gap:6px;" }))
            {
                <input type="text" name="termino" value="@searchTerm" placeholder="Buscar por nombre, cédula..." style="padding:6px 12px;border:1px solid var(--border);border-radius:6px;font-size:14px;" />
                <button type="submit" class="btn btn-soft" style="padding:6px 14px;">
                    <span class="material-symbols-outlined" style="font-size:18px;">search</span>
                </button>
            }
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Cédula</th>
                <th>Rol</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>Salario/hora</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model.Empleados)
            {
                <tr>
                    <td>@emp.IdEmpleado</td>
                    <td>@emp.Nombre @emp.Apellidos</td>
                    <td>@emp.Cedula</td>
                    <td>@(emp.Usuario?.Rol?.NombreRol ?? "")</td>
                    <td>@emp.Telefono</td>
                    <td>@emp.CorreoPersonal</td>
                    <td>@emp.SalarioHora.ToString("N2")</td>
                    <td>
                        @if (emp.Estado)
                        {
                            <span class="status success">Activo</span>
                        }
                        else
                        {
                            <span class="status danger">Inactivo</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Turnos programados (hoy)</h3>
            <p>@DateTime.Today.ToString("dd/MM/yyyy")</p>
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Fecha</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Descripción</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Turnos != null && Model.Turnos.Any())
            {
                foreach (var t in Model.Turnos)
                {
                    <tr>
                        <td>@(t.Empleado != null ? t.Empleado.Nombre + " " + t.Empleado.Apellidos : "")</td>
                        <td>@t.FechaTurno.ToString("dd/MM/yyyy")</td>
                        <td>@t.HoraInicio.ToString(@"hh\:mm")</td>
                        <td>@t.HoraFin.ToString(@"hh\:mm")</td>
                        <td>@t.Descripcion</td>
                        <td><span class="status info">@(t.Estado ? "Activo" : "Inactivo")</span></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6">Sin turnos programados para hoy.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Vacaciones pendientes</h3>
        </div>
        @using (Html.BeginForm("ActualizarVacacionesAcumuladas", "Empleados", FormMethod.Post, new { style = "display:inline;" }))
        {
            <button type="submit" class="btn btn-soft" style="padding:6px 12px;font-size:13px;">
                <span class="material-symbols-outlined" style="font-size:16px;">sync</span> Recalcular saldos
            </button>
        }
    </div>
    <table>
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Días</th>
                <th>Estado</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Vacaciones != null && Model.Vacaciones.Any())
            {
                foreach (var v in Model.Vacaciones)
                {
                    <tr>
                        <td>@(v.Empleado != null ? v.Empleado.Nombre + " " + v.Empleado.Apellidos : "")</td>
                        <td>@v.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@v.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>@v.DiasSolicitados</td>
                        <td><span class="status warning">@v.EstadoSolicitud</span></td>
                        <td>
                            @using (Html.BeginForm("AprobarVacacion", "Empleados", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                <input type="hidden" name="idVacacion" value="@v.IdVacacion" />
                                <button type="submit" class="btn btn-sm btn-success">Aprobar</button>
                            }
                            @using (Html.BeginForm("RechazarVacacion", "Empleados", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                <input type="hidden" name="idVacacion" value="@v.IdVacacion" />
                                <input type="text" name="motivoRechazo" placeholder="Motivo" required style="width:120px;font-size:12px;" />
                                <button type="submit" class="btn btn-sm btn-danger">Rechazar</button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6">Sin solicitudes pendientes.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Vacaciones aprobadas</h3>
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>Empleado</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Días</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.VacacionesAprobadas != null && Model.VacacionesAprobadas.Any())
            {
                foreach (var v in Model.VacacionesAprobadas)
                {
                    <tr>
                        <td>@(v.Empleado != null ? v.Empleado.Nombre + " " + v.Empleado.Apellidos : "")</td>
                        <td>@v.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@v.FechaFin.ToString("dd/MM/yyyy")</td>
                        <td>@v.DiasSolicitados</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4">Sin vacaciones aprobadas.</td></tr>
            }
        </tbody>
    </table>
</div>

<style>
    .empleados-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
    }
    .hero-summary {
        min-width: 260px;
        padding: 18px;
        border-radius: var(--radius-md);
        background: rgba(255,255,255,0.72);
        border: 1px solid var(--border);
    }
    .hero-summary strong,
    .hero-summary span { display: block; }
    .hero-summary strong {
        color: var(--sapphire);
        font-size: 18px;
        margin-bottom: 4px;
    }
    .feature-form-card { border-top: 6px solid var(--emerald); }
    .form-group-wide { grid-column: 1 / -1; }
    .btn-sm { padding: 4px 10px; font-size: 12px; }
    .table-card h4 { margin: 26px 0 12px; color: var(--emerald); }
    @@media (max-width: 900px) {
        .empleados-hero { flex-direction: column; align-items: flex-start; }
        .hero-summary { min-width: 0; width: 100%; }
    }
</style>
