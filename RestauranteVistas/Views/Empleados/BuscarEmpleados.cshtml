@model RestauranteVistas.Models.ViewModels.EmpleadosViewModel
@{ ViewBag.Title = "Resultados de búsqueda"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="page-header">
    <div>
        <h1><span class="material-symbols-outlined">search</span> Buscar empleados</h1>
        <p>@Model.UltimoMovimiento</p>
    </div>
    <div>
        <a href="@Url.Action("Index")" class="btn btn-soft">
            <span class="material-symbols-outlined">arrow_back</span> Volver
        </a>
    </div>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Resultados (@Model.Empleados.Count empleados)</h3>
        </div>
        @using (Html.BeginForm("BuscarEmpleados", "Empleados", FormMethod.Get, new { style = "display:flex;gap:6px;" }))
        {
            <input type="text" name="termino" value="@Model.TerminoBusqueda" placeholder="Buscar..." style="padding:6px 12px;border:1px solid var(--border);border-radius:6px;font-size:14px;" />
            <button type="submit" class="btn btn-soft" style="padding:6px 14px;">
                <span class="material-symbols-outlined" style="font-size:18px;">search</span>
            </button>
        }
    </div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Cédula</th>
                <th>Rol</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>Salario/hora</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model.Empleados)
            {
                <tr>
                    <td>@emp.IdEmpleado</td>
                    <td>@emp.Nombre @emp.Apellidos</td>
                    <td>@emp.Cedula</td>
                    <td>@(emp.Usuario?.Rol?.NombreRol ?? "")</td>
                    <td>@emp.Telefono</td>
                    <td>@emp.CorreoPersonal</td>
                    <td>@emp.SalarioHora.ToString("N2")</td>
                    <td>@if (emp.Estado) { <span class="status success">Activo</span> } else { <span class="status danger">Inactivo</span> }</td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Empleados.Any())
    {
        <div class="empty-state">
            <p>No se encontraron empleados.</p>
        </div>
    }
</div>
