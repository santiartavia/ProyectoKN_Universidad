@using Abstracciones.Models
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ultimosMovimientos = ViewBag.UltimosMovimientos as List<BitacoraRRHH> ?? new List<BitacoraRRHH>();
    var totalEmpleados = ViewBag.TotalEmpleados ?? 0;
}

<div class="hero-card">
    <h2>Panel principal del restaurante</h2>
    <p>
        Bienvenido al sistema visual de gestión del restaurante El Colibrí. Desde este panel puedes
        navegar por todos los módulos del sistema.
    </p>
</div>

<div class="grid-4">
    <div class="metric-card">
        <h3>Ventas del día</h3>
        <div class="value">₡—</div>
    </div>
    <div class="metric-card alt-blue">
        <h3>Pedidos activos</h3>
        <div class="value">—</div>
    </div>
    <div class="metric-card alt-orange">
        <h3>Mesas ocupadas</h3>
        <div class="value">—</div>
    </div>
    <div class="metric-card alt-teal">
        <h3>Empleados activos</h3>
        <div class="value">@totalEmpleados</div>
    </div>
</div>

<div class="section-card">
    <div class="section-title">
        <div>
            <h3>Accesos rápidos</h3>
            <p>Navegación directa a los módulos principales</p>
        </div>
    </div>

    <div class="quick-grid">
        <a class="quick-card" href="@Url.Action("Index","MiAsistencia")">
            <div class="quick-icon bg-emerald"><span class="material-symbols-outlined">fingerprint</span></div>
            <h4>Mi Asistencia</h4>
            <p>Marque su entrada y salida</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","MisVacaciones")">
            <div class="quick-icon bg-sapphire"><span class="material-symbols-outlined">beach_access</span></div>
            <h4>Mis Vacaciones</h4>
            <p>Solicite sus vacaciones</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Empleados")">
            <div class="quick-icon bg-emerald"><span class="material-symbols-outlined">badge</span></div>
            <h4>Empleados</h4>
            <p>Registro y control del personal</p>
        </a>

        <a class="quick-card" href="@Url.Action("Asistencia","Empleados")">
            <div class="quick-icon bg-sapphire"><span class="material-symbols-outlined">admin_panel_settings</span></div>
            <h4>Control Asistencia</h4>
            <p>Gestión de asistencia general</p>
        </a>

        <a class="quick-card" href="@Url.Action("Bitacora","Empleados")">
            <div class="quick-icon bg-iridescent"><span class="material-symbols-outlined">history</span></div>
            <h4>Bitácora</h4>
            <p>Auditoría del sistema</p>
        </a>

        <a class="quick-card" href="@Url.Action("MetricasMesas","Empleados")">
            <div class="quick-icon bg-mandarin"><span class="material-symbols-outlined">leaderboard</span></div>
            <h4>Métricas Mesas</h4>
            <p>Productividad de meseros</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Usuarios")">
            <div class="quick-icon bg-sapphire"><span class="material-symbols-outlined">group</span></div>
            <h4>Usuarios</h4>
            <p>Gestión de cuentas del sistema</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Pedidos")">
            <div class="quick-icon bg-mandarin"><span class="material-symbols-outlined">receipt_long</span></div>
            <h4>Pedidos</h4>
            <p>Seguimiento de órdenes y mesas</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Inventario")">
            <div class="quick-icon bg-iridescent"><span class="material-symbols-outlined">inventory_2</span></div>
            <h4>Inventario</h4>
            <p>Stock y alertas de insumos</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Contabilidad")">
            <div class="quick-icon bg-ruby"><span class="material-symbols-outlined">point_of_sale</span></div>
            <h4>Contabilidad</h4>
            <p>Cierres diarios y caja</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Reporteria")">
            <div class="quick-icon bg-sapphire"><span class="material-symbols-outlined">monitoring</span></div>
            <h4>Reportería</h4>
            <p>Indicadores y exportaciones</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","PuntoVenta")">
            <div class="quick-icon bg-emerald"><span class="material-symbols-outlined">shopping_cart</span></div>
            <h4>Punto de Venta</h4>
            <p>Cobro rápido en caja</p>
        </a>
    </div>
</div>

<div class="grid-2">
    <div class="section-card">
        <div class="section-title">
            <div>
                <h3>Bitácora — últimos movimientos</h3>
                <p>Registro de auditoría del sistema</p>
            </div>
            <a href="@Url.Action("Bitacora","Empleados")" class="btn btn-soft" style="padding:6px 12px;font-size:13px;">
                <span class="material-symbols-outlined">open_in_new</span> Ver todas
            </a>
        </div>

        <div class="info-list">
            @if (ultimosMovimientos.Any())
            {
                foreach (var mov in ultimosMovimientos)
                {
                    <div class="info-row">
                        <span>[@mov.Accion] @mov.TablaAfectada — @(mov.Detalle?.Length > 60 ? mov.Detalle.Substring(0, 60) + "..." : mov.Detalle)</span>
                        <span class="status info">@mov.FechaHora.ToString("dd/MM HH:mm")</span>
                    </div>
                }
            }
            else
            {
                <div class="info-row"><span>No hay movimientos registrados aún</span><span class="status warning">—</span></div>
            }
        </div>
    </div>

    <div class="section-card">
        <div class="section-title">
            <div>
                <h3>Resumen del sistema</h3>
                <p>Estado general de los módulos</p>
            </div>
        </div>

        <div class="banner">
            <strong>@totalEmpleados empleados activos</strong> en el sistema.
            Los módulos de RRHH (empleados, turnos, asistencia, vacaciones, horas extra, bitácora)
            están operativos con base de datos SQL Server.
        </div>

        <div class="form-actions">
            <a href="@Url.Action("Asistencia","Empleados")" class="btn btn-primary">
                <span class="material-symbols-outlined">fingerprint</span> Ir a Asistencia
            </a>
            <a href="@Url.Action("Bitacora","Empleados")" class="btn btn-secondary">
                <span class="material-symbols-outlined">history</span> Ir a Bitácora
            </a>
        </div>
    </div>
</div>