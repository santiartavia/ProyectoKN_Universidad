@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-card">
    <h2>Panel principal del restaurante</h2>
    <p>
        Bienvenido al sistema visual de gestión del restaurante El Colibrí. Desde este panel puedes
        navegar por todos los módulos del sistema y visualizar las historias de usuario representadas
        con una interfaz moderna, limpia y profesional.
    </p>
</div>

<div class="grid-4">
    <div class="metric-card">
        <h3>Ventas del día</h3>
        <div class="value">₡428k</div>
    </div>
    <div class="metric-card alt-blue">
        <h3>Pedidos activos</h3>
        <div class="value">17</div>
    </div>
    <div class="metric-card alt-orange">
        <h3>Mesas ocupadas</h3>
        <div class="value">11</div>
    </div>
    <div class="metric-card alt-teal">
        <h3>Empleados turno</h3>
        <div class="value">14</div>
    </div>
</div>

<div class="section-card">
    <div class="section-title">
        <div>
            <h3>Accesos rápidos</h3>
            <p>Navegación directa a los módulos principales</p>
        </div>
    </div>

    <div class="quick-grid">
        <a class="quick-card" href="@Url.Action("Index","Empleados")">
            <div class="quick-icon bg-emerald"><span class="material-symbols-outlined">badge</span></div>
            <h4>Empleados</h4>
            <p>Registro y control del personal</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Usuarios")">
            <div class="quick-icon bg-sapphire"><span class="material-symbols-outlined">group</span></div>
            <h4>Usuarios</h4>
            <p>Gestión de cuentas del sistema</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Pedidos")">
            <div class="quick-icon bg-mandarin"><span class="material-symbols-outlined">receipt_long</span></div>
            <h4>Pedidos</h4>
            <p>Seguimiento de órdenes y mesas</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Inventario")">
            <div class="quick-icon bg-iridescent"><span class="material-symbols-outlined">inventory_2</span></div>
            <h4>Inventario</h4>
            <p>Stock y alertas de insumos</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Contabilidad")">
            <div class="quick-icon bg-ruby"><span class="material-symbols-outlined">point_of_sale</span></div>
            <h4>Contabilidad</h4>
            <p>Cierres diarios y caja</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","Reporteria")">
            <div class="quick-icon bg-sapphire"><span class="material-symbols-outlined">monitoring</span></div>
            <h4>Reportería</h4>
            <p>Indicadores y exportaciones</p>
        </a>

        <a class="quick-card" href="@Url.Action("Index","PuntoVenta")">
            <div class="quick-icon bg-emerald"><span class="material-symbols-outlined">shopping_cart</span></div>
            <h4>Punto de Venta</h4>
            <p>Cobro rápido en caja</p>
        </a>

        <div class="quick-card" onclick="mostrarToast('Módulo extra visual listo')">
            <div class="quick-icon bg-mandarin"><span class="material-symbols-outlined">bolt</span></div>
            <h4>Acción rápida</h4>
            <p>Botón visual demostrativo</p>
        </div>
    </div>
</div>

<div class="grid-2">
    <div class="section-card">
        <div class="section-title">
            <div>
                <h3>Actividad reciente</h3>
                <p>Movimiento visual del sistema</p>
            </div>
        </div>

        <div class="info-list">
            <div class="info-row"><span>Pedido de Mesa 8 actualizado</span><span class="status info">Hace 2 min</span></div>
            <div class="info-row"><span>Se registró un nuevo empleado</span><span class="status success">Hace 8 min</span></div>
            <div class="info-row"><span>Alerta de stock mínimo en papas</span><span class="status danger">Hace 12 min</span></div>
            <div class="info-row"><span>Reporte diario exportado</span><span class="status warning">Hace 20 min</span></div>
        </div>
    </div>

    <div class="section-card">
        <div class="section-title">
            <div>
                <h3>Resumen del sistema</h3>
                <p>Estado general de los módulos</p>
            </div>
        </div>

        <div class="banner">
            <strong>Resumen:</strong> el sistema presenta todas las áreas clave del restaurante con
            una interfaz visual coherente, moderna y alineada a la cromática definida en tu documento.
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" onclick="mostrarToast('Vista general cargada correctamente')">
                <span class="material-symbols-outlined">check_circle</span> Probar dashboard
            </button>
            <button class="btn btn-secondary" onclick="abrirModal('modalAyuda')">
                <span class="material-symbols-outlined">help</span> Ver ayuda
            </button>
        </div>
    </div>
</div>