@{
    ViewBag.Title = "Crear contrasena";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-card" style="max-width:520px;margin:0 auto;">
    <div style="text-align:center;">
        <span class="material-symbols-outlined" style="font-size:48px;color:var(--sapphire);">lock_reset</span>
        <h2>Crear contrasena</h2>
        <p>Bienvenido. Establezca su contrasena para continuar.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="section-card" style="border-left:4px solid #c62828;padding:12px 18px;margin:16px 0;background:#ffebee;">
            <h3 style="color:#c62828;margin:0;">@TempData["Error"]</h3>
        </div>
    }

    @using (Html.BeginForm("CrearPassword", "Login", FormMethod.Post))
    {
        <div class="form-grid" style="grid-template-columns:1fr;">
            <div class="form-group">
                <label>Nueva contrasena *</label>
                <input type="password" name="passwordNuevo" required minlength="12" />
                <small style="color:#666;">Minimo 12 caracteres, 1 mayuscula, 1 numero, 1 caracter especial</small>
            </div>
            <div class="form-group">
                <label>Confirmar contrasena *</label>
                <input type="password" name="passwordConfirmar" required minlength="12" />
            </div>
        </div>

        <div class="section-card" style="border-left:4px solid #ff9800;padding:12px;margin:16px 0;background:#fff8e1;">
            <p style="margin:0;font-size:13px;color:#664;">
                <strong>Requisitos:</strong> minimo 12 caracteres, al menos 1 mayuscula, 1 numero y 1 caracter especial.
            </p>
        </div>

        <div class="form-actions" style="justify-content:center;margin-top:16px;">
            <button type="submit" class="btn btn-primary">
                <span class="material-symbols-outlined">save</span> Crear contrasena
            </button>
        </div>
    }
</div>
