@{
    ViewBag.Title = "Cambiar contrasena";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool cambioForzado = ViewBag.CambioForzado ?? false;
}

<div class="hero-card" style="max-width:520px;margin:0 auto;">
    <div style="text-align:center;">
        <span class="material-symbols-outlined" style="font-size:48px;color:var(--sapphire);">lock_reset</span>
        <h2>Cambiar contrasena</h2>
        @if (cambioForzado)
        {
            <p style="color:#c62828;font-weight:600;">No podra continuar sin cambiar su contrasena.</p>
        }
        else
        {
            <p>Por seguridad, cambie su contrasena periodicamente.</p>
        }
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="section-card" style="border-left:4px solid #c62828;padding:12px 18px;margin:16px 0;background:#ffebee;">
            <h3 style="color:#c62828;margin:0;">@ViewBag.Error</h3>
        </div>
    }
    @if (ViewBag.Mensaje != null)
    {
        <div class="section-card" style="border-left:4px solid #2e7d32;padding:12px 18px;margin:16px 0;background:#e8f5e9;">
            <h3 style="color:#2e7d32;margin:0;">@ViewBag.Mensaje</h3>
        </div>
    }

    @using (Html.BeginForm("CambiarPassword", "Login", FormMethod.Post))
    {
        <div class="form-grid" style="grid-template-columns:1fr;">
            @if (!cambioForzado)
            {
                <div class="form-group">
                    <label>Contrasena actual *</label>
                    <input type="password" name="passwordActual" required />
                </div>
            }
            <div class="form-group">
                <label>Nueva contrasena *</label>
                <input type="password" name="passwordNuevo" required minlength="12" />
                <small style="color:#666;">Minimo 12 caracteres, 1 mayuscula, 1 numero, 1 caracter especial</small>
            </div>
            <div class="form-group">
                <label>Confirmar nueva contrasena *</label>
                <input type="password" name="passwordConfirmar" required minlength="12" />
            </div>
        </div>

        <div class="section-card" style="border-left:4px solid #ff9800;padding:12px;margin:16px 0;background:#fff8e1;">
            <p style="margin:0;font-size:13px;color:#664;">
                <strong>Requisitos:</strong> minimo 12 caracteres, al menos 1 mayuscula, 1 numero y 1 caracter especial.
                No puede usar ninguna de las ultimas 5 contrasenas anteriores.
            </p>
        </div>

        <div class="form-actions" style="justify-content:center;margin-top:16px;">
            <button type="submit" class="btn btn-primary">
                <span class="material-symbols-outlined">save</span> Cambiar contrasena
            </button>
        </div>
    }
</div>
