@{
    Layout = null;
    ViewBag.Title = "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Restaurante El Colibrí</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body class="login-body">
    <div class="login-wrapper">
        <div class="login-panel left">
            <div class="login-brand">
                <div class="login-brand-icon">
                    <span class="material-symbols-outlined">restaurant_menu</span>
                </div>
                <div>
                    <h1>Restaurante El Colibrí</h1>
                    <p>Sistema de gestión restaurantera</p>
                </div>
            </div>
            <div class="login-message">
                <h2>Inicio de sesión</h2>
                <p>Ingrese sus credenciales para acceder al sistema.</p>
                <div class="login-tags">
                    <span class="chip"><i class="fa-solid fa-user-shield"></i> Administrador</span>
                    <span class="chip"><i class="fa-solid fa-cash-register"></i> Cajero</span>
                    <span class="chip"><i class="fa-solid fa-bell-concierge"></i> Mesero</span>
                    <span class="chip"><i class="fa-solid fa-utensils"></i> Cocinero</span>
                </div>
            </div>
        </div>
        <div class="login-panel right">
            <div class="login-card">
                <h2>Iniciar sesión</h2>
                <p>Acceso al sistema</p>
                @if (TempData["ErrorLogin"] != null)
                {
                    <div class="banner" style="margin-bottom:18px;">
                        <strong>Error:</strong> @TempData["ErrorLogin"]
                    </div>
                }
                @using (Html.BeginForm("Entrar", "Login", FormMethod.Post))
                {
                    <div class="form-group">
                        <label>Usuario</label>
                        <input type="text" name="usuario" placeholder="Nombre de usuario" required />
                    </div>
                    <div class="form-group">
                        <label>Contraseña</label>
                        <input type="password" name="password" placeholder="Contraseña" required />
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary btn-full">
                            <span class="material-symbols-outlined">login</span> Entrar al sistema
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
    <div id="toast" class="toast"></div>
    <script src="~/Scripts/site.js"></script>
</body>
</html>