            <div class="form-group" data-filtro="stockBajo" style="display:flex;align-items:center;gap:8px;padding-top:24px;">
                <input type="checkbox" name="stockBajo" value="true" id="chkStockBajo" />
                <label for="chkStockBajo" style="margin:0;">Solo insumos con stock bajo</label>
            </div>
            <div class="form-actions" style="grid-column:1/-1;">
                <button type="submit" class="btn btn-secondary"><span class="material-symbols-outlined">description</span> Generar</button>
            </div>
        </form>
    </div>
    }
</div>

@if (Session["ReporteResultado"] != null)
{
    ViewData["ReporteDescargarAction"] = "DescargarReporteGenerado";
    Html.RenderPartial("_ResultadoReporte");
}
else if (TempData["ReporteVacio"] != null)
{
    <div class="form-card" style="text-align:center;padding:32px;">
        <p>@(TempData["ReporteMensajeVacio"]?.ToString() ?? "No se encontraron registros para el reporte solicitado en el rango de fechas especificado.")</p>
    </div>
}

@if (Model.Cierres != null && Model.Cierres.Any())
{
    <div class="table-card">
        <div class="section-title">
            <h3>Historial de cierres</h3>
            <p>@Model.Cierres.Count registros</p>
        </div>
        <table>
            <thead>
                <tr>
                    <th># Cierre</th>
                    <th>Cajero</th>
                    <th>Fecha</th>
                    <th>Apertura</th>
                    <th>Efectivo</th>
                    <th>SINPE</th>
                    <th>Tarjeta</th>
                    <th>Egresos</th>
                    <th>Esperado</th>
                    <th>Real</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Cierres)
                {
                    <tr>
                        <td>@c.IdCierre</td>
                        <td>@(c.Cajero != null ? c.Cajero.Nombre + " " + c.Cajero.Apellidos : "")</td>
                        <td>@c.FechaCierre.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@c.MontoApertura.ToString("N2")</td>
                        <td>@c.TotalEfectivo.ToString("N2")</td>
                        <td>@c.TotalSinpe.ToString("N2")</td>
                        <td>@c.TotalTarjeta.ToString("N2")</td>
                        <td>@c.TotalEgresos.ToString("N2")</td>
                        <td>@c.SaldoEsperado.ToString("N2")</td>
                        <td>@c.SaldoReal.ToString("N2")</td>
                        <td>
                            @if (c.Descuadre)
                            {
                                <span class="status danger">Descuadre</span>
                            }
                            else
                            {
                                <span class="status success">Cuadrado</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (rol == "Administrador" && Model.Reportes != null && Model.Reportes.Any())
{
    <div class="table-card">
        <div class="section-title">
            <h3>Historial de reportes generados</h3>
            <p>@Model.Reportes.Count registros</p>
        </div>
        <div style="margin-bottom:8px;text-align:right;">
            <a href="@Url.Action("ExportarHistorialReportesCsv")" class="btn btn-sm btn-primary" style="display:inline-flex;align-items:center;gap:4px;">
                <span class="material-symbols-outlined" style="font-size:16px;">download</span> Exportar CSV
            </a>
            <a href="@Url.Action("BitacoraReportes", "Reporteria")" class="btn btn-sm" style="display:inline-flex;align-items:center;gap:4px;margin-left:8px;">
                <span class="material-symbols-outlined" style="font-size:16px;">history</span> Ver bitácora de reportes
            </a>
        </div>
        <table>
            <thead>
                <tr><th>#</th><th>Tipo</th><th>Formato</th><th>Fecha</th><th>Usuario</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reportes)
                {
                    <tr>
                        <td>@r.IdReporte</td>
                        <td>@r.TipoReporte</td>
                        <td>@r.FormatoSalida.ToUpper()</td>
                        <td>@r.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(ViewBag.NombreEmpleados != null && ViewBag.NombreEmpleados.ContainsKey(r.IdUsuario) ? ViewBag.NombreEmpleados[r.IdUsuario] : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (rol == "Administrador")
{
