@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="banner" style="background:#e8f5e9;border-left-color:#2e7d32;"><strong>@Model.Mensaje</strong></div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="banner" style="background:#ffebee;border-left-color:#c62828;"><strong>@Model.Error</strong></div>
}
@if (TempData["ReporteError"] != null)
{
    <div class="banner" style="background:#fff3e0;border-left-color:#e65100;"><strong>@TempData["ReporteError"]</strong></div>
}
@if (!string.IsNullOrEmpty(Model.Alerta))
{
    <div class="banner" style="background:#fff3e0;border-left-color:#e65100;"><strong>@Model.Alerta</strong></div>
}

@if (TempData.Keys.Contains("ReporteCierre"))
{
    <div class="banner" style="background:#e3f2fd;border-left-color:#1565c0;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <strong style="flex:1;">Reporte de cierre generado</strong>
        <a href="@Url.Action("DescargarReporteCierre")" class="btn btn-sm" style="display:inline-flex;align-items:center;gap:4px;">
            <span class="material-symbols-outlined" style="font-size:18px;">download</span> Descargar CSV
        </a>
    </div>
}

<div class="grid-2">
    @if (rol == "Cajero")
    {
    <div class="form-card">
        <div class="section-title"><h3>Abrir caja</h3></div>
        <p>Inicie un nuevo turno</p>
        <form method="post" action="@Url.Action("AbrirCaja")" class="form-grid">
            <div class="form-group">
                <label>Caja</label>
                <select name="idCaja" required>
                    <option value="">Seleccione...</option>
                    @if (Model.CajasCerradas != null)
                    {
                        foreach (var c in Model.CajasCerradas)
                        {
                            <option value="@c.IdCaja">@c.NombreCaja</option>
                        }
                    }
                </select>
            </div>
            @if (Model.IdCajero.HasValue)
            {
                <input type="hidden" name="idCajero" value="@Model.IdCajero" />
            }
            else
            {
                <div class="form-group">
                    <label>ID Cajero (Empleado)</label>
                    <input type="number" name="idCajero" required min="1" />
    </div>
}

@functions {
    public static string[] ParseCsvLine(string line)
    {
        var result = new System.Collections.Generic.List<string>();
        var current = new System.Text.StringBuilder();
        bool inQuotes = false;
        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            if (c == '"')
            {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"')
                {
                    current.Append('"');
                    i++;
                }
                else
                {
                    inQuotes = !inQuotes;
                }
            }
            else if (c == ',' && !inQuotes)
            {
                result.Add(current.ToString());
                current.Clear();
            }
            else
            {
                current.Append(c);
            }
        }
        result.Add(current.ToString());
        return result.ToArray();
    }
}
            <div class="form-group">
                <label>Monto inicial</label>
                <input type="number" name="montoInicial" step="0.01" value="0" min="0" />
            </div>
            <div class="form-group">
                <label>Observaciones</label>
                <input type="text" name="observaciones" maxlength="300" />
            </div>
            <div class="form-actions" style="grid-column:1/-1;">
                <button type="submit" class="btn btn-primary">Abrir caja</button>
            </div>
        </form>
    </div>
    }

    @if (rol == "Administrador")
    {
    <div class="form-card">
        <div class="section-title"><h3>Cerrar caja</h3></div>
        @if (Model.AperturasActivas != null && Model.AperturasActivas.Any())
        {
            <form method="post" action="@Url.Action("CerrarCaja")" class="form-grid">
                <div class="form-group">
                    <label>Apertura activa</label>
                    <select name="idApertura" required>
                        <option value="">Seleccione...</option>
                        @foreach (var ap in Model.AperturasActivas)
                        {
                            <option value="@ap.IdApertura">#@ap.IdApertura - @(ap.Caja != null ? ap.Caja.NombreCaja : "") (@ap.MontoInicial.ToString("N2"))</option>
                        }
                    </select>
                </div>
                @if (Model.AperturaActiva != null)
                {
                    <div class="form-group">
                        <label>Saldo esperado (ref)</label>
                        <input type="text" value="@Model.SaldoEsperado.ToString("N2")" readonly style="background:#f5f5f5;" />
                    </div>
                }
                <div class="form-group">
                    <label>Saldo real</label>
                    <input type="number" name="saldoReal" step="0.01" required />
                </div>
                <div class="form-actions" style="grid-column:1/-1;">
                    <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined">payments</span> Cerrar caja</button>
                </div>
            </form>
        }
        else
        {
            <p>No hay aperturas activas.</p>
        }
    </div>
    }
</div>

@if (Model.AperturaActiva != null)
{
    <div class="grid-4">
        <div class="metric-card">
            <h3>Apertura</h3>
            <div class="value">@Model.AperturaActiva.MontoInicial.ToString("N2")</div>
            <small>#@Model.AperturaActiva.IdApertura - @(Model.AperturaActiva.Caja != null ? Model.AperturaActiva.Caja.NombreCaja : "")</small>
        </div>
        <div class="metric-card alt-blue">
            <h3>Efectivo</h3>
            <div class="value">@Model.Ventas.Where(v => v.MetodoPago == "efectivo").Sum(v => v.TotalCobrado).ToString("N2")</div>
        </div>
        <div class="metric-card alt-orange">
            <h3>SINPE</h3>
            <div class="value">@Model.Ventas.Where(v => v.MetodoPago == "sinpe").Sum(v => v.TotalCobrado).ToString("N2")</div>
        </div>
        <div class="metric-card alt-red">
            <h3>Egresos</h3>
            <div class="value">@Model.Egresos.Sum(e => e.Monto).ToString("N2")</div>
        </div>
    </div>
}

@if (Model.AperturaActiva != null && rol == "Administrador")
{
    <div class="form-card">
        <div class="section-title">
            <h3>Registrar egreso</h3>
            <small>Apertura #@Model.AperturaActiva.IdApertura</small>
        </div>
        <form method="post" action="@Url.Action("RegistrarEgreso")" class="form-grid">
            <input type="hidden" name="idApertura" value="@Model.AperturaActiva.IdApertura" />
            <div class="form-group">
                <label>Categoría</label>
                <select name="categoriaGasto" required>
                    <option value="">Seleccione...</option>
                    @if (Model.CategoriasGasto != null)
                    {
                        foreach (var cat in Model.CategoriasGasto)
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Descripción</label>
                <input type="text" name="descripcion" maxlength="300" />
            </div>
            <div class="form-group">
                <label>Monto</label>
                <input type="number" name="monto" step="0.01" min="0.01" required />
            </div>
            <div class="form-actions" style="grid-column:1/-1;">
                <button type="submit" class="btn btn-primary"><span class="material-symbols-outlined">money_off</span> Registrar egreso</button>
            </div>
        </form>
    </div>
}

@if (Model.AperturaActiva != null && Model.Egresos.Any())
{
    <div class="form-card">
        <div class="section-title" style="margin-top:18px;"><h3>Egresos registrados</h3></div>
        <table>
            <thead><tr><th>Categoría</th><th>Descripción</th><th>Monto</th><th>Fecha</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Egresos)
                {
                    <tr>
                        <td>@e.CategoriaGasto</td>
                        <td>@e.Descripcion</td>
                        <td>@e.Monto.ToString("N2")</td>
                        <td>@e.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="grid-2">
