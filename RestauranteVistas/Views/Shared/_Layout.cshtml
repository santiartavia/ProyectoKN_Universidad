@{
    var usuario = Session["UsuarioNombre"] != null ? Session["UsuarioNombre"].ToString() : "Usuario Demo";
    var rol = Session["RolNombre"] != null ? Session["RolNombre"].ToString() : "";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Restaurante El Colibrí</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-icon">
                    <span class="material-symbols-outlined">restaurant</span>
                </div>
                <div>
                    <h2>El Colibrí</h2>
                    <p>Sistema visual profesional</p>
                </div>
            </div>

            <div class="sidebar-user">
                <div class="avatar-circle">
                    @(usuario.Length >= 2 ? usuario.Substring(0, 2).ToUpper() : "US")
                </div>
                <div>
                    <strong>@usuario</strong>
                    <small>@rol</small>
                </div>
            </div>

            <nav class="menu">
                @if (rol == "Administrador")
                {
                    <a href="@Url.Action("Index", "Home")"><span class="material-symbols-outlined">space_dashboard</span> Dashboard</a>
                    <a href="@Url.Action("Index", "MiAsistencia")"><span class="material-symbols-outlined">fingerprint</span> Mi Asistencia</a>
                    <a href="@Url.Action("Index", "MisVacaciones")"><span class="material-symbols-outlined">beach_access</span> Mis Vacaciones</a>
                    <a href="@Url.Action("Index", "Empleados")"><span class="material-symbols-outlined">badge</span> Empleados</a>
                    <a href="@Url.Action("Asistencia", "Empleados")"><span class="material-symbols-outlined">admin_panel_settings</span> Control Asistencia</a>
                    <a href="@Url.Action("MetricasMesas", "Empleados")"><span class="material-symbols-outlined">leaderboard</span> Métricas Mesas</a>
                    <a href="@Url.Action("Index", "Usuarios")"><span class="material-symbols-outlined">group</span> Usuarios</a>
                    <a href="@Url.Action("Index", "Mesas")"><span class="material-symbols-outlined">table_restaurant</span> Mesas</a>
                    <a href="@Url.Action("Index", "Pedidos")"><span class="material-symbols-outlined">receipt_long</span> Pedidos</a>
                    <a href="@Url.Action("Index", "Productos")"><span class="material-symbols-outlined">restaurant_menu</span> Productos</a>
                    <a href="@Url.Action("Index", "Inventario")"><span class="material-symbols-outlined">inventory_2</span> Inventario</a>
                    <a href="@Url.Action("Index", "NominaMensual")"><span class="material-symbols-outlined">payments</span> Nómina Mensual</a>
                    <a href="@Url.Action("Index", "Contabilidad")"><span class="material-symbols-outlined">point_of_sale</span> Contabilidad</a>
                    <a href="@Url.Action("Index", "Reporteria")"><span class="material-symbols-outlined">monitoring</span> Reportería</a>
                    <a href="@Url.Action("Index", "PuntoVenta")"><span class="material-symbols-outlined">shopping_cart</span> Punto de Venta</a>
                    <a href="@Url.Action("Index", "OperacionPdv")"><span class="material-symbols-outlined">monitor_heart</span> Operación PDV</a>
                    <hr style="border-color:rgba(255,255,255,0.12);margin:8px 0;">
                    <a href="@Url.Action("Index", "BitacoraPdv")"><span class="material-symbols-outlined">fact_check</span> Bitácora PDV</a>
                    <a href="@Url.Action("Bitacora", "Empleados")"><span class="material-symbols-outlined">history</span> Bitácora RRHH</a>
                    <a href="@Url.Action("Index", "BitacoraPedidos")"><span class="material-symbols-outlined">receipt_long</span> Bit. Pedidos</a>
                    <a href="@Url.Action("BitacoraAcceso", "Usuarios")"><span class="material-symbols-outlined">security</span> Accesos</a>
                    <a href="@Url.Action("Bitacora", "Inventario")"><span class="material-symbols-outlined">inventory</span> Bit. Inventario</a>
                    <a href="@Url.Action("Bitacora", "Contabilidad")"><span class="material-symbols-outlined">account_balance</span> Bit. Financiera</a>
                    <a href="@Url.Action("BitacoraReportes", "Reporteria")"><span class="material-symbols-outlined">receipt_long</span> Bit. Reportes</a>
                }
                else if (rol == "Cajero")
                {
                    <a href="@Url.Action("Index", "MiAsistencia")"><span class="material-symbols-outlined">fingerprint</span> Mi Asistencia</a>
                    <a href="@Url.Action("Index", "MisVacaciones")"><span class="material-symbols-outlined">beach_access</span> Mis Vacaciones</a>
                    <a href="@Url.Action("Index", "Cajero")"><span class="material-symbols-outlined">point_of_sale</span> Panel Cajero</a>
                    <a href="@Url.Action("Index", "PuntoVenta")"><span class="material-symbols-outlined">shopping_cart</span> Punto de Venta</a>
                    <a href="@Url.Action("Index", "OperacionPdv")"><span class="material-symbols-outlined">monitor_heart</span> Operación PDV</a>
                    <a href="@Url.Action("Index", "Contabilidad")"><span class="material-symbols-outlined">payments</span> Cierres</a>
                    <a href="@Url.Action("Index", "Contabilidad")"><span class="material-symbols-outlined">receipt_long</span> Cuentas</a>
                }
                else if (rol == "Mesero")
                {
                    <a href="@Url.Action("Index", "MiAsistencia")"><span class="material-symbols-outlined">fingerprint</span> Mi Asistencia</a>
                    <a href="@Url.Action("Index", "MisVacaciones")"><span class="material-symbols-outlined">beach_access</span> Mis Vacaciones</a>
                    <a href="@Url.Action("Index", "Mesero")"><span class="material-symbols-outlined">room_service</span> Panel Mesero</a>
                    <a href="@Url.Action("Index", "Mesas")"><span class="material-symbols-outlined">table_restaurant</span> Mesas</a>
                    <a href="@Url.Action("Index", "Pedidos")"><span class="material-symbols-outlined">receipt_long</span> Pedidos</a>
                }
                else if (rol == "Cocinero")
                {
                    <a href="@Url.Action("Index", "MiAsistencia")"><span class="material-symbols-outlined">fingerprint</span> Mi Asistencia</a>
                    <a href="@Url.Action("Index", "MisVacaciones")"><span class="material-symbols-outlined">beach_access</span> Mis Vacaciones</a>
                    <a href="@Url.Action("Index", "Cocina")"><span class="material-symbols-outlined">skillet</span> Panel Cocina</a>
                    <a href="@Url.Action("Index", "Pedidos")"><span class="material-symbols-outlined">receipt_long</span> Seguimiento</a>
                }

            </nav>

            <a href="@Url.Action("Logout", "Login")" style="display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;color:var(--white);font-weight:600;transition:0.25s ease;margin-top:8px;">
                <span class="material-symbols-outlined">logout</span> Cerrar sesión
            </a>
            <a href="@Url.Action("CambiarPassword", "Login")" style="font-size:13px;opacity:0.7;display:flex;align-items:center;gap:12px;padding:10px 16px;border-radius:16px;color:var(--white);">
                <span class="material-symbols-outlined">lock</span> Cambiar contraseña
            </a>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <div>
                    <h1>@ViewBag.Title</h1>
                    <p>Vista correspondiente al rol: @rol</p>
                </div>

                <div class="top-actions">
                    <button class="btn btn-soft" onclick="mostrarToast('Vista actualizada correctamente')">
                        <span class="material-symbols-outlined">refresh</span> Actualizar
                    </button>
                    <button class="btn btn-secondary" onclick="abrirModal('modalAyuda')">
                        <span class="material-symbols-outlined">help</span> Ayuda
                    </button>
                </div>
            </header>

            <section class="page-body">
                @RenderBody()
            </section>
        </main>
    </div>

    <div id="modalAyuda" class="custom-modal">
        <div class="custom-modal-content">
            <div class="modal-header">
                <h3>Información del rol</h3>
                <button class="icon-btn" onclick="cerrarModal('modalAyuda')">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <p>
                El sistema muestra menús y vistas distintas según el rol seleccionado en el login.
                Todo es visual y demostrativo.
            </p>
            <div class="modal-actions">
                <button class="btn btn-primary" onclick="cerrarModal('modalAyuda')">Entendido</button>
            </div>
        </div>
    </div>

    <div id="toast" class="toast"></div>

    <div id="modalSesionExpirada" class="custom-modal">
        <div class="custom-modal-content" style="max-width:420px;text-align:center;">
            <div class="modal-header" style="justify-content:center;">
                <h3 style="display:flex;align-items:center;gap:8px;">
                    <span class="material-symbols-outlined" style="color:var(--mandarin);">timer_off</span>
                    Sesión expirada
                </h3>
            </div>
            <p id="mensajeSesionExpirada" style="margin:20px 0 8px;font-size:15px;color:var(--charcoal);"></p>
            <div class="modal-actions" style="justify-content:center;">
                <button class="btn btn-primary" onclick="window.location.href='@Url.Action("Index", "Login")'">
                    Ir al inicio de sesión
                </button>
            </div>
        </div>
    </div>

    <script src="~/Scripts/site.js"></script>
    <script>
        // Heartbeat: verificar sesión activa cada 30 segundos
        setInterval(function () {
            fetch('@Url.Action("VerificarSesion", "Login")')
                .then(function (r) { return r.json(); })
                .then(function (d) {
                    if (!d.activa) {
                        document.getElementById('mensajeSesionExpirada').textContent =
                            d.mensaje || 'Sesión expirada por inactividad.';
                        abrirModal('modalSesionExpirada');
                    }
                })
                .catch(function () {});
        }, 30000);
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
