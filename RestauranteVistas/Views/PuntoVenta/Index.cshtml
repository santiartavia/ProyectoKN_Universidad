@{
    ViewBag.Title = "Punto de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-card">
    <h2>Punto de venta visual</h2>
    <p>
        Módulo diseñado para representar ventas rápidas de mostrador, apertura de ticket,
        agregado de productos y cobro visual.
    </p>
</div>

<div class="grid-3">
    <div class="metric-card"><h3>Caja activa</h3><div class="value">Caja 1</div></div>
    <div class="metric-card alt-blue"><h3>Ventas rápidas</h3><div class="value">23</div></div>
    <div class="metric-card alt-orange"><h3>Total del turno</h3><div class="value">₡144k</div></div>
</div>

<div class="grid-2">
    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>Apertura de venta rápida</h3>
                <p>Flujo de caja</p>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group"><label>ID Venta</label><input type="text" placeholder="7001" /></div>
            <div class="form-group">
                <label>Tipo</label>
                <select>
                    <option>RÁPIDA</option>
                </select>
            </div>
            <div class="form-group"><label>Fecha y hora</label><input type="datetime-local" /></div>
            <div class="form-group"><label>ID Usuario</label><input type="text" placeholder="502" /></div>
            <div class="form-group"><label>Nombre cajero</label><input type="text" placeholder="Valeria Castro" /></div>
            <div class="form-group"><label>ID Caja</label><input type="text" placeholder="1" /></div>
            <div class="form-group"><label>Producto</label><input type="text" placeholder="Café frío" /></div>
            <div class="form-group"><label>Cantidad</label><input type="number" placeholder="1" /></div>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" onclick="accionDemo('Se abrió la venta rápida correctamente')">
                <span class="material-symbols-outlined">add_business</span> Abrir venta
            </button>
            <button class="btn btn-secondary" onclick="accionDemo('Productos agregados al detalle de venta')">
                <span class="material-symbols-outlined">shopping_cart_checkout</span> Agregar producto
            </button>
            <button class="btn btn-danger" onclick="accionDemo('La venta fue cancelada antes del cobro')">
                <span class="material-symbols-outlined">cancel</span> Cancelar
            </button>
        </div>
    </div>

    <div class="table-card">
        <div class="section-title">
            <div>
                <h3>Ticket de venta</h3>
                <p>Detalle del consumo</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Café frío</td>
                    <td>1</td>
                    <td>₡2 500</td>
                    <td>₡2 500</td>
                </tr>
                <tr>
                    <td>Empanada</td>
                    <td>2</td>
                    <td>₡1 200</td>
                    <td>₡2 400</td>
                </tr>
                <tr>
                    <td colspan="3"><strong>Total</strong></td>
                    <td><strong>₡4 900</strong></td>
                </tr>
            </tbody>
        </table>

        <div class="form-actions">
            <button class="btn btn-primary" onclick="accionDemo('Cobro visual realizado')">
                <span class="material-symbols-outlined">paid</span> Cobrar
            </button>
            <button class="btn btn-warning" onclick="accionDemo('No se puede cobrar una venta vacía')">
                <span class="material-symbols-outlined">do_not_disturb_on</span> Probar bloqueo
            </button>
        </div>
    </div>
</div>

<div class="story-card">
    <h4>Historias reflejadas en punto de venta</h4>
    <div class="accordion">
        <div class="accordion-item">
            <button class="accordion-header">Abrir venta rápida <span>+</span></button>
            <div class="accordion-content">La venta se crea para registrar consumo inmediato sin orden previa.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Asociación a cajero y caja <span>+</span></button>
            <div class="accordion-content">La venta queda identificada con el usuario responsable y la caja activa.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Venta inicialmente vacía <span>+</span></button>
            <div class="accordion-content">Se pueden agregar productos después de abrir la venta.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Cancelación antes de cobrar <span>+</span></button>
            <div class="accordion-content">La venta puede cancelarse visualmente antes de finalizar el cobro.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Bloqueo por detalle vacío <span>+</span></button>
            <div class="accordion-content">No se permite simular el cobro si no hay productos agregados.</div>
        </div>
    </div>
</div>