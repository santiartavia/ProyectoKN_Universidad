@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Seguimiento de Pedidos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var productos = ViewBag.Productos as List<Abstracciones.Models.Producto>;
    var pedidos = ViewBag.Pedidos as List<Abstracciones.Models.Pedido>;
    var detalles = ViewBag.Detalles as List<Abstracciones.Models.DetallePedido>;
}

<div class="hero-card">
    <h2>Seguimiento visual de pedidos</h2>
    <p>
        Sigue los pedidos de tus mesas en tiempo real. Crea nuevas órdenes, agrega productos a las existentes y monitorea el estado de cada pedido para brindar un servicio eficiente y personalizado.
    </p>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="grid-4">
    <div class="metric-card"><h3>Mesas ocupadas</h3><div class="value">11</div></div>
    <div class="metric-card alt-blue"><h3>En preparación</h3><div class="value">7</div></div>
    <div class="metric-card alt-orange"><h3>Listos</h3><div class="value">4</div></div>
    <div class="metric-card alt-teal"><h3>Entregados</h3><div class="value">19</div></div>
</div>

<div class="grid-2">
    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>Crear orden</h3>
                <p>Vista operativa para meseros</p>
            </div>
        </div>

        @using (Html.BeginForm("CrearOrden", "Pedidos", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group"><label>ID Mesa</label><input type="number" name="idMesa" placeholder="12" required /></div>
                <div class="form-group"><label>Número de mesa</label><input type="text" placeholder="Mesa 12" /></div>
                <div class="form-group"><label>ID Mesero</label><input type="number" name="idMesero" placeholder="301" required /></div>
                <div class="form-group"><label>Nombre mesero</label><input type="text" placeholder="Daniel Rojas" /></div>
                <div class="form-group"><label>Comensales</label><input type="number" name="comensales" placeholder="4" required /></div>

                <div class="form-group">
                    <label>Producto</label>
                    <select name="idProducto" required>
                        <option value="">Seleccione producto</option>
                        @if (productos != null)
                        {
                            foreach (var prod in productos)
                            {
                                <option value="@prod.IdProducto">@prod.NombreProducto - ₡@prod.PrecioVenta</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group"><label>Cantidad</label><input type="number" name="cantidad" placeholder="1" min="1" required /></div>

                <div class="form-group">
                    <label>Tipo de servicio</label>
                    <select name="tipoServicio">
                        <option value="mesa">Salón</option>
                        <option value="para_llevar">Para llevar</option>
                        <option value="delivery">Delivery</option>
                    </select>
                </div>
            </div>

            <div class="form-group" style="margin-top:16px;">
                <label>Observaciones</label>
                <textarea name="observaciones" placeholder="Sin cebolla, extra salsa, término medio..."></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">add_shopping_cart</span> Crear orden
                </button>
            </div>
        }

        <hr />

        <h3>Agregar producto a orden existente</h3>

        @using (Html.BeginForm("AgregarProducto", "Pedidos", FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label>Pedido existente</label>
                    <select name="idPedido" required>
                        <option value="">Seleccione pedido</option>
                        @if (pedidos != null)
                        {
                            foreach (var pedido in pedidos.Where(p => p.EstadoPedido == "abierto"))
                            {
                                <option value="@pedido.IdPedido">Pedido #@pedido.IdPedido - Mesa @pedido.IdMesa - @pedido.EstadoPedido</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Producto</label>
                    <select name="idProducto" required>
                        <option value="">Seleccione producto</option>
                        @if (productos != null)
                        {
                            foreach (var prod in productos)
                            {
                                <option value="@prod.IdProducto">@prod.NombreProducto - ₡@prod.PrecioVenta</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Cantidad</label>
                    <input type="number" name="cantidad" min="1" placeholder="1" required />
                </div>

                <div class="form-group">
                    <label>Observaciones del producto</label>
                    <input type="text" name="observacionesItem" placeholder="Sin cebolla, extra salsa..." />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-secondary">
                    <span class="material-symbols-outlined">playlist_add</span> Agregar producto
                </button>
                <button type="button" class="btn btn-warning" onclick="accionDemo('Validación realizada')">
                    <span class="material-symbols-outlined">error</span> Validar campos
                </button>
            </div>
        }
    </div>

    <div class="table-card">
        <div class="section-title">
            <div>
                <h3>Pedidos activos</h3>
                <p>Monitoreo por mesa</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Mesa</th>
                    <th>Mesero</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (pedidos != null && pedidos.Any())
                {
                    foreach (var pedido in pedidos)
                    {
                        var detallesPedido = detalles != null ? detalles.Where(d => d.IdPedido == pedido.IdPedido).ToList() : null;
                        decimal total = detallesPedido != null ? detallesPedido.Sum(d => d.Cantidad * d.PrecioUnitario) : 0;

                        <tr>
                            <td>Mesa @pedido.IdMesa</td>
                            <td>@pedido.IdEmpleado</td>
                            <td>
                                @if (detallesPedido != null && detallesPedido.Any())
                                {
                                    foreach (var item in detallesPedido)
                                    {
                                        var prod = productos != null ? productos.FirstOrDefault(p => p.IdProducto == item.IdProducto) : null;
                                        <div>
                                            @(prod != null ? prod.NombreProducto : "Producto no encontrado")
                                            x @item.Cantidad
                                            - @item.ObservacionesItem
                                            [@item.EstadoItem]
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span>Sin productos</span>
                                }
                            </td>
                            <td>
                                @if (pedido.EstadoPedido == "abierto")
                                {
                                    <span class="status warning">Abierto</span>
                                }
                                else if (pedido.EstadoPedido == "en_proceso")
                                {
                                    <span class="status info">En preparación</span>
                                }
                                else if (pedido.EstadoPedido == "listo")
                                {
                                    <span class="status success">Lista</span>
                                }
                                else if (pedido.EstadoPedido == "cancelado")
                                {
                                    <span class="status danger">Cancelado</span>
                                }
                                else
                                {
                                    <span class="status">@pedido.EstadoPedido</span>
                                }
                            </td>
                            <td>₡@total</td>
                            <td><button class="btn btn-soft" onclick="accionDemo('Pedido #@pedido.IdPedido: @pedido.Observaciones')">Ver</button></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">No hay pedidos activos registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="table-card" style="margin-top:25px;">
    <div class="section-title">
        <div>
            <h3>Modificar o cancelar órdenes</h3>
            <p>Solo órdenes abiertas pueden modificarse o cancelarse</p>
        </div>
    </div>

    @if (pedidos != null && pedidos.Any(p => p.EstadoPedido == "abierto"))
    {
        foreach (var pedido in pedidos.Where(p => p.EstadoPedido == "abierto"))
        {
            var detallesPedido = detalles != null ? detalles.Where(d => d.IdPedido == pedido.IdPedido).ToList() : null;

            <div class="quick-card" style="margin-bottom:20px;">
                <h4>Pedido #@pedido.IdPedido</h4>
                <p><strong>Mesa:</strong> @pedido.IdMesa</p>
                <p><strong>Estado:</strong> @pedido.EstadoPedido</p>
                <p><strong>Observaciones:</strong> @pedido.Observaciones</p>

                <table style="margin-top:15px;">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad actual</th>
                            <th>Observación actual</th>
                            <th>Editar</th>
                            <th>Eliminar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (detallesPedido != null && detallesPedido.Any())
                        {
                            foreach (var item in detallesPedido)
                            {
                                var prod = productos != null ? productos.FirstOrDefault(p => p.IdProducto == item.IdProducto) : null;

                                <tr>
                                    <td>@(prod != null ? prod.NombreProducto : "Producto no encontrado")</td>
                                    <td>@item.Cantidad</td>
                                    <td>@item.ObservacionesItem</td>
                                    <td>
                                        @using (Html.BeginForm("EditarProducto", "Pedidos", FormMethod.Post))
                                        {
                                            @Html.Hidden("idDetalle", item.IdDetalle)
                                            <input type="number" name="cantidad" value="@item.Cantidad" min="1" step="0.01" required />
                                            <input type="text" name="observacionesItem" value="@item.ObservacionesItem" />
                                            <button type="submit" class="btn btn-warning">Modificar producto</button>
                                        }
                                    </td>
                                    <td>
                                        @using (Html.BeginForm("EliminarProducto", "Pedidos", FormMethod.Post))
                                        {
                                            @Html.Hidden("idDetalle", item.IdDetalle)
                                            <button type="submit" class="btn btn-secondary">Eliminar producto</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">Esta orden no tiene productos activos.</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="form-actions" style="margin-top:15px;">
                    @using (Html.BeginForm("CancelarPedido", "Pedidos", FormMethod.Post))
                    {
                        @Html.Hidden("idPedido", pedido.IdPedido)
                        <input type="text" name="motivoCancelacion" placeholder="Motivo de cancelación" />
                        <button type="submit" class="btn btn-warning">Cancelar orden</button>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p>No hay órdenes abiertas disponibles para modificación.</p>
    }
</div>