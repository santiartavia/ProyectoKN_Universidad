@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Seguimiento de Pedidos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var productos = ViewBag.Productos as List<Abstracciones.Models.Producto>;
    var pedidos = ViewBag.Pedidos as List<Abstracciones.Models.Pedido>;
    var detalles = ViewBag.Detalles as List<Abstracciones.Models.DetallePedido>;
    var meseros = ViewBag.Meseros as List<Abstracciones.Models.Empleado>;
    var nombresMesas = ViewBag.NombresMesas as Dictionary<int, string> ?? new Dictionary<int, string>();
    var nombresEmpleados = ViewBag.NombresEmpleados as Dictionary<int, string> ?? new Dictionary<int, string>();
    int meseroActualId = ViewBag.MeseroId != null ? (int)ViewBag.MeseroId : 0;
}

<div class="hero-card">
    <h2>Seguimiento visual de pedidos</h2>
    <p>
        Sigue los pedidos de tus mesas en tiempo real. Crea nuevas órdenes, asigna el mesero encargado, agrega productos a las existentes y monitorea el estado de cada pedido.
    </p>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="grid-4">
    <div class="metric-card"><h3>Mesas ocupadas</h3><div class="value">@(ViewBag.MesasOcupadas ?? 0)</div></div>
    <div class="metric-card alt-blue"><h3>En preparación</h3><div class="value">@(ViewBag.EnPreparacion ?? 0)</div></div>
    <div class="metric-card alt-orange"><h3>Listos</h3><div class="value">@(ViewBag.Listos ?? 0)</div></div>
    <div class="metric-card alt-teal"><h3>Entregados</h3><div class="value">@(ViewBag.Entregados ?? 0)</div></div>
</div>

<div class="grid-2">
    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>Crear orden</h3>
                <p>Vista operativa para meseros (descuenta insumos de receta automáticamente al confirmar)</p>
            </div>
        </div>

        @using (Html.BeginForm("CrearOrden", "Pedidos", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
            <div class="form-grid">
                <div class="form-group">
                    <label>Mesa *</label>
                    <select name="idMesa" required>
                        <option value="">Seleccione mesa</option>
                        @if (ViewBag.Mesas != null)
                        {
                            foreach (var mesa in ViewBag.Mesas)
                            {
                                <option value="@mesa.IdMesa">@mesa.NumeroMesa (Cap: @mesa.Capacidad - @mesa.EstadoMesa)</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Mesero *</label>
                    <select name="idEmpleado" required>
                        @if (meseros != null && meseros.Any())
                        {
                            foreach (var emp in meseros)
                            {
                                <option value="@emp.IdEmpleado" @(emp.IdEmpleado == meseroActualId ? "selected" : "")>
                                    @emp.Nombre @emp.Apellidos (@(emp.Usuario?.Rol?.NombreRol ?? "Personal"))
                                </option>
                            }
                        }
                        else
                        {
                            <option value="@meseroActualId">@(ViewBag.MeseroNombre ?? "Mesero activo")</option>
                        }
                    </select>
                </div>
                <div class="form-group"><label>Comensales *</label><input type="number" name="comensales" value="2" min="1" max="50" required /></div>

                <div class="form-group">
                    <label>Producto *</label>
                    <select name="idProducto" required>
                        <option value="">Seleccione producto</option>
                        @if (productos != null)
                        {
                            foreach (var prod in productos)
                            {
                                <option value="@prod.IdProducto">@prod.NombreProducto - ₡@prod.PrecioVenta.ToString("N2")</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group"><label>Cantidad *</label><input type="number" name="cantidad" value="1" min="1" required /></div>

                <div class="form-group">
                    <label>Tipo de servicio</label>
                    <select name="tipoServicio">
                        <option value="mesa">Salón</option>
                        <option value="para_llevar">Para llevar</option>
                        <option value="delivery">Delivery</option>
                    </select>
                </div>
            </div>

            <div class="form-group" style="margin-top:16px;">
                <label>Observaciones</label>
                <textarea name="observaciones" placeholder="Sin cebolla, extra salsa, término medio..."></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">add_shopping_cart</span> Confirmar y crear orden
                </button>
            </div>
        }

        <hr />

        <h3>Agregar producto a orden existente</h3>

        @using (Html.BeginForm("AgregarProducto", "Pedidos", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
            <div class="form-grid">
                <div class="form-group">
                    <label>Pedido existente *</label>
                    <select name="idPedido" required>
                        <option value="">Seleccione pedido</option>
                        @if (pedidos != null)
                        {
                            foreach (var pedido in pedidos.Where(p => p.EstadoPedido == "abierto"))
                            {
                                var numMesa = pedido.IdMesa.HasValue && nombresMesas.ContainsKey(pedido.IdMesa.Value)
                                    ? nombresMesas[pedido.IdMesa.Value]
                                    : ("Mesa " + pedido.IdMesa);
                                <option value="@pedido.IdPedido">Pedido #@pedido.IdPedido - @numMesa (@pedido.EstadoPedido)</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Producto *</label>
                    <select name="idProducto" required>
                        <option value="">Seleccione producto</option>
                        @if (productos != null)
                        {
                            foreach (var prod in productos)
                            {
                                <option value="@prod.IdProducto">@prod.NombreProducto - ₡@prod.PrecioVenta.ToString("N2")</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Cantidad *</label>
                    <input type="number" name="cantidad" min="1" value="1" required />
                </div>

                <div class="form-group">
                    <label>Observaciones del producto</label>
                    <input type="text" name="observacionesItem" placeholder="Sin cebolla, extra salsa..." />
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-secondary">
                    <span class="material-symbols-outlined">playlist_add</span> Agregar producto
                </button>
            </div>
        }
    </div>

    <div class="table-card">
        <div class="section-title">
            <div>
                <h3>Pedidos registrados</h3>
                <p>Monitoreo por mesa y entrega al cliente</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Pedido / Mesa</th>
                    <th>Mesero</th>
                    <th>Descripción</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (pedidos != null && pedidos.Any())
                {
                    foreach (var pedido in pedidos)
                    {
                        var detallesPedido = detalles != null ? detalles.Where(d => d.IdPedido == pedido.IdPedido).ToList() : null;
                        decimal total = detallesPedido != null ? detallesPedido.Sum(d => d.Cantidad * d.PrecioUnitario) : 0;
                        var nombreMesa = pedido.IdMesa.HasValue && nombresMesas.ContainsKey(pedido.IdMesa.Value)
                            ? nombresMesas[pedido.IdMesa.Value]
                            : ("Mesa " + pedido.IdMesa);
                        var nombreMesero = nombresEmpleados.ContainsKey(pedido.IdEmpleado)
                            ? nombresEmpleados[pedido.IdEmpleado]
                            : ("Empleado #" + pedido.IdEmpleado);

                        <tr>
                            <td><strong>#@pedido.IdPedido</strong> - @nombreMesa</td>
                            <td>@nombreMesero</td>
                            <td>
                                @if (detallesPedido != null && detallesPedido.Any())
                                {
                                    foreach (var item in detallesPedido)
                                    {
                                        var prod = productos != null ? productos.FirstOrDefault(p => p.IdProducto == item.IdProducto) : null;
                                        <div>
                                            @(prod != null ? prod.NombreProducto : ("Producto #" + item.IdProducto))
                                            x @item.Cantidad
                                            @(string.IsNullOrEmpty(item.ObservacionesItem) ? "" : $"({item.ObservacionesItem})")
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span>Sin productos</span>
                                }
                            </td>
                            <td>
                                @if (pedido.EstadoPedido == "abierto")
                                {
                                    <span class="status warning">Abierto</span>
                                }
                                else if (pedido.EstadoPedido == "en_proceso")
                                {
                                    <span class="status info">En preparación</span>
                                }
                                else if (pedido.EstadoPedido == "listo")
                                {
                                    <span class="status success">Listo para entregar</span>
                                }
                                else if (pedido.EstadoPedido == "entregado")
                                {
                                    <span class="status info">Entregado</span>
                                }
                                else if (pedido.EstadoPedido == "finalizado")
                                {
                                    <span class="status success">Finalizado</span>
                                }
                                else if (pedido.EstadoPedido == "cancelado")
                                {
                                    <span class="status danger">Cancelado</span>
                                }
                                else
                                {
                                    <span class="status">@pedido.EstadoPedido</span>
                                }
                            </td>
                            <td><strong>₡@total.ToString("N2")</strong></td>
                            <td>
                                @if (pedido.EstadoPedido == "listo")
                                {
                                    using (Html.BeginForm("MarcarEntregado", "Pedidos", FormMethod.Post, new { style = "display:inline;" }))
                                    {
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
                                        <input type="hidden" name="idPedido" value="@pedido.IdPedido" />
                                        <button type="submit" class="btn btn-primary btn-sm">Marcar Entregado</button>
                                    }
                                }
                                else if (pedido.EstadoPedido == "entregado")
                                {
                                    <a href="@Url.Action("Index", "Cajero")" class="btn btn-soft btn-sm">Ir a Caja</a>
                                }
                                else
                                {
                                    <span style="color:#666;font-size:12px;">@(string.IsNullOrEmpty(pedido.Observaciones) ? "—" : pedido.Observaciones)</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">No hay pedidos activos registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="table-card" style="margin-top:25px;">
    <div class="section-title">
        <div>
            <h3>Modificar o cancelar órdenes</h3>
            <p>Solo órdenes abiertas pueden modificarse o cancelarse</p>
        </div>
    </div>

    @if (pedidos != null && pedidos.Any(p => p.EstadoPedido == "abierto"))
    {
        foreach (var pedido in pedidos.Where(p => p.EstadoPedido == "abierto"))
        {
            var detallesPedido = detalles != null ? detalles.Where(d => d.IdPedido == pedido.IdPedido).ToList() : null;
            var nombreMesa = pedido.IdMesa.HasValue && nombresMesas.ContainsKey(pedido.IdMesa.Value)
                ? nombresMesas[pedido.IdMesa.Value]
                : ("Mesa " + pedido.IdMesa);

            <div class="quick-card" style="margin-bottom:20px;">
                <h4>Pedido #@pedido.IdPedido (@nombreMesa)</h4>
                <p><strong>Estado:</strong> @pedido.EstadoPedido | <strong>Observaciones:</strong> @(string.IsNullOrEmpty(pedido.Observaciones) ? "Ninguna" : pedido.Observaciones)</p>

                <table style="margin-top:15px;">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad actual</th>
                            <th>Observación actual</th>
                            <th>Editar</th>
                            <th>Eliminar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (detallesPedido != null && detallesPedido.Any())
                        {
                            foreach (var item in detallesPedido)
                            {
                                var prod = productos != null ? productos.FirstOrDefault(p => p.IdProducto == item.IdProducto) : null;

                                <tr>
                                    <td>@(prod != null ? prod.NombreProducto : "Producto no encontrado")</td>
                                    <td>@item.Cantidad</td>
                                    <td>@item.ObservacionesItem</td>
                                    <td>
                                        @using (Html.BeginForm("EditarProducto", "Pedidos", FormMethod.Post))
                                        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
                                            @Html.Hidden("idDetalle", item.IdDetalle)
                                            <input type="number" name="cantidad" value="@item.Cantidad.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="1" step="1" required />
                                            <input type="text" name="observacionesItem" value="@item.ObservacionesItem" />
                                            <button type="submit" class="btn btn-warning">Modificar producto</button>
                                        }
                                    </td>
                                    <td>
                                        @using (Html.BeginForm("EliminarProducto", "Pedidos", FormMethod.Post))
                                        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
                                            @Html.Hidden("idDetalle", item.IdDetalle)
                                            <button type="submit" class="btn btn-secondary">Eliminar producto</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">Esta orden no tiene productos activos.</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="form-actions" style="margin-top:15px;">
                    @using (Html.BeginForm("CancelarPedido", "Pedidos", FormMethod.Post))
                    {
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestKey" value="@Guid.NewGuid()" />
                        @Html.Hidden("idPedido", pedido.IdPedido)
                        <input type="text" name="motivoCancelacion" placeholder="Motivo de cancelación" />
                        <button type="submit" class="btn btn-warning">Cancelar orden</button>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p>No hay órdenes abiertas disponibles para modificación.</p>
    }
</div>
