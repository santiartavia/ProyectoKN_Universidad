@{
    ViewBag.Title = "Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-card">
    <h2>Control visual de inventario</h2>
    <p>
        Módulo orientado al registro de insumos, visualización de existencias y simulación
        de alertas de stock mínimo dentro del restaurante.
    </p>
</div>

<div class="grid-3">
    <div class="metric-card"><h3>Insumos activos</h3><div class="value">63</div></div>
    <div class="metric-card alt-red"><h3>Alertas mínimas</h3><div class="value">7</div></div>
    <div class="metric-card alt-teal"><h3>Categorías</h3><div class="value">9</div></div>
</div>

<div class="grid-2">
    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>Registrar insumo</h3>
                <p>Formulario de catálogo visual</p>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group"><label>Nombre del insumo</label><input type="text" placeholder="Tomate" /></div>
            <div class="form-group">
                <label>Categoría</label>
                <select>
                    <option>Vegetales</option>
                    <option>Carnes</option>
                    <option>Bebidas</option>
                    <option>Lácteos</option>
                </select>
            </div>
            <div class="form-group">
                <label>Unidad de medida</label>
                <select>
                    <option>Kg</option>
                    <option>Litros</option>
                    <option>Unidad</option>
                </select>
            </div>
            <div class="form-group"><label>Stock mínimo</label><input type="number" placeholder="10" /></div>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" onclick="accionDemo('Insumo registrado correctamente')">
                <span class="material-symbols-outlined">inventory</span> Registrar
            </button>
            <button class="btn btn-warning" onclick="accionDemo('Complete todos los campos obligatorios')">
                <span class="material-symbols-outlined">report</span> Validar
            </button>
            <button class="btn btn-danger" onclick="accionDemo('Ya existe un insumo con ese nombre')">
                <span class="material-symbols-outlined">block</span> Duplicado
            </button>
        </div>
    </div>

    <div class="table-card">
        <div class="section-title">
            <div>
                <h3>Existencias actuales</h3>
                <p>Vista de insumos</p>
            </div>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Insumo</th>
                    <th>Categoría</th>
                    <th>Unidad</th>
                    <th>Existencia</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Tomate</td>
                    <td>Vegetales</td>
                    <td>Kg</td>
                    <td>12</td>
                    <td><span class="status success">Normal</span></td>
                </tr>
                <tr>
                    <td>Papa</td>
                    <td>Vegetales</td>
                    <td>Kg</td>
                    <td>4</td>
                    <td><span class="status danger">Bajo mínimo</span></td>
                </tr>
                <tr>
                    <td>Carne molida</td>
                    <td>Carnes</td>
                    <td>Kg</td>
                    <td>0</td>
                    <td><span class="status warning">Agotado</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="story-card">
    <h4>Escenarios representados</h4>
    <div class="accordion">
        <div class="accordion-item">
            <button class="accordion-header">Registro correcto de insumo <span>+</span></button>
            <div class="accordion-content">El sistema inserta el nuevo insumo y lo deja listo para su seguimiento.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Insumo duplicado <span>+</span></button>
            <div class="accordion-content">No se permite registrar otro insumo con el mismo nombre.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Stock inicial en cero <span>+</span></button>
            <div class="accordion-content">La vista contempla la creación de insumos sin compra inicial.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Campos obligatorios <span>+</span></button>
            <div class="accordion-content">Nombre y categoría son indispensables para registrar el insumo.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Stock mínimo inválido <span>+</span></button>
            <div class="accordion-content">No se admite un valor negativo para el stock mínimo.</div>
        </div>
    </div>
</div>