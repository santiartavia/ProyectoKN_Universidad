@model RestauranteVistas.Models.ViewModels.BitacoraReportesViewModel
@{
    ViewBag.Title = "Bitácora de Reportes";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empleados = ViewBag.NombreEmpleados as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="hero-card">
    <h2>Bitácora de reportes</h2>
    <p>Registro de generación y descarga de reportes. Los registros no pueden ser modificados ni eliminados.</p>
</div>

<a href="@Url.Action("Index")" class="btn btn-sm" style="margin-bottom:12px;display:inline-flex;align-items:center;gap:6px;">
    <span class="material-symbols-outlined">arrow_back</span> Volver
</a>

@if (!string.IsNullOrEmpty(TempData["Mensaje"]?.ToString()))
{
    <div class="banner" style="background:#e8f5e9;border-left-color:#2e7d32;"><strong>@TempData["Mensaje"]</strong></div>
}
@if (!string.IsNullOrEmpty(TempData["Error"]?.ToString()))
{
    <div class="banner" style="background:#ffebee;border-left-color:#c62828;"><strong>@TempData["Error"]</strong></div>
}

<div class="form-card">
    <div class="section-title"><h3>Filtros</h3></div>
    <form method="get" action="@Url.Action("BitacoraReportes")" class="form-grid">
        <div class="form-group">
            <label>Usuario</label>
            <select name="idUsuario">
                <option value="">Todos</option>
                @foreach (var kvp in empleados)
                {
                    <option value="@kvp.Key" @(Model.FiltroUsuario == kvp.Key ? "selected" : "")>@kvp.Value</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label>Acción</label>
            <select name="accion">
                <option value="">Todas</option>
                @if (Model.Acciones != null)
                {
                    foreach (var a in Model.Acciones)
                    {
                        <option value="@a" @(Model.FiltroAccion == a ? "selected" : "")>@a</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label>Fecha inicio</label>
            <input type="date" name="fechaInicio" value="@Model.FiltroFechaInicio" />
        </div>
        <div class="form-group">
            <label>Fecha fin</label>
            <input type="date" name="fechaFin" value="@Model.FiltroFechaFin" />
        </div>
        <div class="form-actions" style="grid-column:1/-1;">
            <button type="submit" class="btn btn-secondary"><span class="material-symbols-outlined">search</span> Filtrar</button>
            <a href="@Url.Action("ExportarBitacoraReportes", new { formato = "csv", idUsuario = Model.FiltroUsuario, accion = Model.FiltroAccion, fechaInicio = Model.FiltroFechaInicio, fechaFin = Model.FiltroFechaFin })" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:6px;">
                <span class="material-symbols-outlined">download</span> CSV
            </a>
            <a href="@Url.Action("ExportarBitacoraReportes", new { formato = "xls", idUsuario = Model.FiltroUsuario, accion = Model.FiltroAccion, fechaInicio = Model.FiltroFechaInicio, fechaFin = Model.FiltroFechaFin })" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:6px;">
                <span class="material-symbols-outlined">download</span> Excel
            </a>
            <a href="@Url.Action("ExportarBitacoraReportes", new { formato = "pdf", idUsuario = Model.FiltroUsuario, accion = Model.FiltroAccion, fechaInicio = Model.FiltroFechaInicio, fechaFin = Model.FiltroFechaFin })" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:6px;">
                <span class="material-symbols-outlined">download</span> PDF
            </a>
        </div>
    </form>
</div>

@if (Model.Registros != null && Model.Registros.Any())
{
    <div class="table-card">
        <div class="section-title">
            <h3>Registros</h3>
            <p>@Model.Registros.Count resultados</p>
        </div>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Detalle</th>
                    <th>IP</th>
                    <th>Dispositivo</th>
                    <th>Fecha/Hora</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Registros)
                {
                    <tr>
                        <td>@r.IdRegistro</td>
                        <td>@(empleados.ContainsKey(r.IdUsuario) ? empleados[r.IdUsuario] : r.Usuario?.NombreUsuario ?? "")</td>
                        <td>@r.Accion</td>
                        <td style="max-width:300px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@r.Detalle">@r.Detalle</td>
                        <td>@r.IpOrigen</td>
                        <td style="max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@r.Dispositivo">@r.Dispositivo</td>
                        <td>@r.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>
                            <a href="@Url.Action("RegenerarReporte", new { idRegistro = r.IdRegistro })" class="btn btn-sm" style="display:inline-flex;align-items:center;gap:4px;" title="Volver a generar este reporte">
                                <span class="material-symbols-outlined" style="font-size:16px;">download</span> Descargar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="form-card" style="text-align:center;padding:32px;">
        <p>No se encontraron registros en la bitácora de reportes.</p>
    </div>
}
