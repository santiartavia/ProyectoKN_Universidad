@{
    ViewBag.Title = "Reportería";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-card">
    <h2>Generación visual de reportes</h2>
    <p>
        Este módulo presenta filtros, indicadores y una tabla de resultados para reflejar la
        generación de reportes administrativos del restaurante.
    </p>
</div>

<div class="grid-2">
    <div class="form-card">
        <div class="section-title">
            <div>
                <h3>Parámetros del reporte</h3>
                <p>Consulta por fechas y formato</p>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group"><label>ID Usuario</label><input type="text" placeholder="501" /></div>
            <div class="form-group"><label>Fecha inicio</label><input type="date" /></div>
            <div class="form-group"><label>Fecha fin</label><input type="date" /></div>
            <div class="form-group">
                <label>Formato</label>
                <select>
                    <option>PDF</option>
                    <option>Excel</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" onclick="accionDemo('Reporte generado correctamente')">
                <span class="material-symbols-outlined">analytics</span> Generar
            </button>
            <button class="btn btn-secondary" onclick="accionDemo('Archivo PDF preparado para descarga')">
                <span class="material-symbols-outlined">picture_as_pdf</span> Exportar PDF
            </button>
            <button class="btn btn-warning" onclick="accionDemo('Archivo Excel preparado para descarga')">
                <span class="material-symbols-outlined">table_view</span> Exportar Excel
            </button>
            <button class="btn btn-danger" onclick="accionDemo('La fecha final no puede ser menor a la inicial')">
                <span class="material-symbols-outlined">event_busy</span> Validar fechas
            </button>
        </div>
    </div>

    <div class="section-card">
        <div class="section-title">
            <div>
                <h3>Indicadores</h3>
                <p>Resumen del período</p>
            </div>
        </div>

        <div class="grid-2">
            <div class="metric-card"><h3>Total ventas</h3><div class="value">₡925k</div></div>
            <div class="metric-card alt-blue"><h3>Facturas</h3><div class="value">126</div></div>
            <div class="metric-card alt-orange"><h3>Efectivo</h3><div class="value">₡410k</div></div>
            <div class="metric-card alt-teal"><h3>SINPE</h3><div class="value">₡515k</div></div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Detalle del reporte</h3>
            <p>Resultados demostrativos</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Factura</th>
                <th>Fecha</th>
                <th>Método</th>
                <th>Monto</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>F-1001</td>
                <td>03/04/2026</td>
                <td>Efectivo</td>
                <td>₡8 500</td>
                <td><span class="status success">Pagada</span></td>
            </tr>
            <tr>
                <td>F-1002</td>
                <td>03/04/2026</td>
                <td>SINPE</td>
                <td>₡12 900</td>
                <td><span class="status success">Pagada</span></td>
            </tr>
            <tr>
                <td>F-1003</td>
                <td>03/04/2026</td>
                <td>Efectivo</td>
                <td>₡6 200</td>
                <td><span class="status success">Pagada</span></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="story-card">
    <h4>Historias del módulo de reportería</h4>
    <div class="accordion">
        <div class="accordion-item">
            <button class="accordion-header">Generación exitosa del reporte <span>+</span></button>
            <div class="accordion-content">El sistema prepara visualmente el reporte con todos los datos consolidados.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Sin ventas en el rango <span>+</span></button>
            <div class="accordion-content">Se refleja la condición cuando no existen registros en el período consultado.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Fechas incoherentes <span>+</span></button>
            <div class="accordion-content">La fecha final no puede ser menor que la fecha inicial.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Exportar PDF <span>+</span></button>
            <div class="accordion-content">La interfaz simula la generación de un PDF descargable.</div>
        </div>
        <div class="accordion-item">
            <button class="accordion-header">Exportar Excel <span>+</span></button>
            <div class="accordion-content">La interfaz simula la exportación del informe a Excel.</div>
        </div>
    </div>
</div>