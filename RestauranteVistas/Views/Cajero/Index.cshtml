@{
    ViewBag.Title = "Panel de Cajero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="hero-card">
    <h2>Panel principal del cajero</h2>
    <p>
        Acá podrás gestionar ventas rápidas, cobros, cierres de caja
        y revisión de cuentas del día.
    </p>
</div>

<div class="grid-4">
    <div class="metric-card"><h3>Ventas del turno</h3><div class="value">₡144k</div></div>
    <div class="metric-card alt-blue"><h3>Facturas cobradas</h3><div class="value">23</div></div>
    <div class="metric-card alt-orange"><h3>Pendientes</h3><div class="value">4</div></div>
    <div class="metric-card alt-red"><h3>Cierres hoy</h3><div class="value">1</div></div>
</div>

<div class="grid-3">
    <div class="quick-card">
        <div class="quick-icon bg-emerald"><span class="material-symbols-outlined">shopping_cart</span></div>
        <h4>Punto de Venta</h4>
        <p>Registrar cobros y ventas rápidas.</p>
        <a class="btn btn-primary" href="@Url.Action("Index","PuntoVenta")">Ir</a>
    </div>

    <div class="quick-card">
        <div class="quick-icon bg-sapphire"><span class="material-symbols-outlined">payments</span></div>
        <h4>Cierre de Caja</h4>
        <p>Controlar saldos y cierre diario.</p>
        <a class="btn btn-secondary" href="@Url.Action("Index","Contabilidad")">Ir</a>
    </div>

    <div class="quick-card">
        <div class="quick-icon bg-mandarin"><span class="material-symbols-outlined">receipt_long</span></div>
        <h4>Cuentas</h4>
        <p>Visualizar cuentas abiertas y cerradas.</p>
        <button class="btn btn-warning" onclick="mostrarToast('Vista de cuentas cargada visualmente')">Abrir</button>
    </div>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Operaciones recientes</h3>
            <p>Actividad del cajero</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Hora</th>
                <th>Operación</th>
                <th>Monto</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>10:05 AM</td>
                <td>Cobro mesa 8</td>
                <td>₡12 900</td>
                <td><span class="status success">Completado</span></td>
            </tr>
            <tr>
                <td>10:18 AM</td>
                <td>Venta rápida</td>
                <td>₡4 900</td>
                <td><span class="status info">Procesado</span></td>
            </tr>
            <tr>
                <td>10:30 AM</td>
                <td>Cierre parcial</td>
                <td>₡58 000</td>
                <td><span class="status warning">En revisión</span></td>
            </tr>
        </tbody>
    </table>
</div>