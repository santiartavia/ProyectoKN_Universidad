@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Panel de Mesero";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var pedidosListos = ViewBag.PedidosListos as List<Abstracciones.Models.Pedido>;
    var pedidosEntregados = ViewBag.PedidosEntregados as List<Abstracciones.Models.Pedido>;
    var detalles = ViewBag.Detalles as List<Abstracciones.Models.DetallePedido>;
    var productos = ViewBag.Productos as List<Abstracciones.Models.Producto>;
}

<div class="hero-card">
    <h2>Panel principal del mesero</h2>
    <p>
        Atiende mesas y pedidos de forma moderna.
        Visualiza tus mesas asignadas, el estado de los pedidos y accede rápidamente a las funciones clave para tu trabajo.
    </p>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="grid-4">
    <div class="metric-card"><h3>Mesas asignadas</h3><div class="value">6</div></div>
    <div class="metric-card alt-blue"><h3>Pedidos activos</h3><div class="value">9</div></div>
    <div class="metric-card alt-orange"><h3>Listos para servir</h3><div class="value">@(pedidosListos != null ? pedidosListos.Count : 0)</div></div>
    <div class="metric-card alt-teal"><h3>Clientes atendidos</h3><div class="value">@(pedidosEntregados != null ? pedidosEntregados.Count : 0)</div></div>
</div>

<div class="grid-2">
    <div class="section-card">
        <div class="section-title">
            <div>
                <h3>Mis mesas</h3>
                <p>Control visual del salón</p>
            </div>
        </div>

        <div class="grid-2">
            <div class="metric-card"><h3>Mesa 1</h3><div class="value">Ocupada</div></div>
            <div class="metric-card alt-blue"><h3>Mesa 4</h3><div class="value">En espera</div></div>
            <div class="metric-card alt-orange"><h3>Mesa 6</h3><div class="value">Pidiendo cuenta</div></div>
            <div class="metric-card alt-teal"><h3>Mesa 9</h3><div class="value">Atendida</div></div>
        </div>
    </div>

    <div class="section-card">
        <div class="section-title">
            <div>
                <h3>Acciones rápidas</h3>
                <p>Operación del mesero</p>
            </div>
        </div>

        <div class="form-actions">
            <a class="btn btn-primary" href="@Url.Action("Index","Pedidos")">
                <span class="material-symbols-outlined">receipt_long</span> Ir a pedidos
            </a>
            <a class="btn btn-secondary" href="@Url.Action("Index","Pedidos")">
                <span class="material-symbols-outlined">add_circle</span> Nueva orden
            </a>
            <button class="btn btn-warning" onclick="mostrarToast('Cuenta solicitada a caja')">
                <span class="material-symbols-outlined">payments</span> Pedir cuenta
            </button>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="section-title">
        <div>
            <h3>Pedidos de mis mesas</h3>
            <p>Seguimiento visual</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Mesa</th>
                <th>Pedido</th>
                <th>Estado</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td>Casado + refresco</td>
                <td><span class="status info">En cocina</span></td>
                <td><button class="btn btn-soft" onclick="mostrarToast('Detalle de pedido abierto')">Ver</button></td>
            </tr>
            <tr>
                <td>4</td>
                <td>Pasta + café</td>
                <td><span class="status warning">Pendiente</span></td>
                <td><button class="btn btn-soft" onclick="mostrarToast('Detalle de pedido abierto')">Ver</button></td>
            </tr>
            <tr>
                <td>6</td>
                <td>Hamburguesa + papas</td>
                <td><span class="status success">Lista</span></td>
                <td><button class="btn btn-soft" onclick="mostrarToast('Pedido marcado para servir')">Servir</button></td>
            </tr>
        </tbody>
    </table>
</div>

<div class="table-card" style="margin-top:25px;">
    <div class="section-title">
        <div>
            <h3>Pedidos listos para entregar</h3>
            <p>Solo pedidos en estado listo</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Mesa</th>
                <th>Pedido</th>
                <th>Productos</th>
                <th>Estado</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @if (pedidosListos != null && pedidosListos.Any())
            {
                foreach (var pedido in pedidosListos)
                {
                    var detallesPedido = detalles != null ? detalles.Where(d => d.IdPedido == pedido.IdPedido).ToList() : null;

                    <tr>
                        <td>Mesa @pedido.IdMesa</td>
                        <td>Pedido #@pedido.IdPedido</td>
                        <td>
                            @if (detallesPedido != null && detallesPedido.Any())
                            {
                                foreach (var item in detallesPedido)
                                {
                                    var prod = productos != null ? productos.FirstOrDefault(p => p.IdProducto == item.IdProducto) : null;
                                    <div>
                                        @(prod != null ? prod.NombreProducto : "Producto")
                                        x @item.Cantidad
                                        - @item.ObservacionesItem
                                    </div>
                                }
                            }
                            else
                            {
                                <span>Sin productos</span>
                            }
                        </td>
                        <td><span class="status success">Lista</span></td>
                        <td>
                            @using (Html.BeginForm("EntregarPedido", "Mesero", FormMethod.Post))
                            {
                                @Html.Hidden("idPedido", pedido.IdPedido)
                                <button type="submit" class="btn btn-primary">Entregar pedido</button>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5">No hay pedidos listos para entregar.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="table-card" style="margin-top:25px;">
    <div class="section-title">
        <div>
            <h3>Pedidos entregados</h3>
            <p>Pedidos habilitados para pago</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Mesa</th>
                <th>Pedido</th>
                <th>Fecha entrega</th>
                <th>Estado</th>
                <th>Pago</th>
            </tr>
        </thead>
        <tbody>
            @if (pedidosEntregados != null && pedidosEntregados.Any())
            {
                foreach (var pedido in pedidosEntregados)
                {
                    <tr>
                        <td>Mesa @pedido.IdMesa</td>
                        <td>Pedido #@pedido.IdPedido</td>
                        <td>@(pedido.FechaHoraEntrega.HasValue ? pedido.FechaHoraEntrega.Value.ToString("dd/MM/yyyy HH:mm") : "Sin fecha")</td>
                        <td><span class="status info">Entregado</span></td>
                        <td><button class="btn btn-warning" onclick="mostrarToast('Pedido habilitado para pago')">Habilitado</button></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5">No hay pedidos entregados.</td>
                </tr>
            }
        </tbody>
    </table>
</div>